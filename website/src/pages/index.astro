---
import KucedrLandingPage from "../components/KucedrLandingPage.astro";
import { buildHomepageStructuredData } from "../lib/structured-data";
import Layout from "../layouts/Layout.astro";

const locale = "en";
const title = "Kucedr: A Personal AI Assistant for Your Desktop";
const description = "Kucedr is a personal desktop AI assistant that works with files, searches the web, runs tools, and uses your chosen AI providers and permissions.";
const siteBaseUrl = Astro.site ?? new URL("https://kucedr.haraldbregu.com");
const structuredData = buildHomepageStructuredData({
  description,
  featureNames: ["Personal context and preferences", "Schedules and recurring plans", "Background tasks", "Connected tools and services", "Multi-step task completion", "Custom Extensions"],
  locale,
  siteBaseUrl,
  tagline: "A personal AI assistant that turns requests into useful work on your desktop.",
});
---

<Layout
  alternatePath="/"
  bodyClass="kucedr-landing-page"
  description={description}
  exactTitle
  footerVariant="landing"
  hideBackgroundEffects
  hideHeader
  image="/og/kucedr-personal-ai-assistant.png"
  locale={locale}
  ogDescription={description}
  ogTitle={title}
  structuredData={structuredData}
  title={title}
>
  <KucedrLandingPage />
</Layout>
