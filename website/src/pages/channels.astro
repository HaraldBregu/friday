---
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import ProductPageHero from "../components/ProductPageHero.astro";
import channels from "../data/channels.json";
import ProductPageLayout from "../layouts/ProductPageLayout.astro";

const supported = channels.filter((channel) => channel.runtime === "supported");
const planned = channels.filter((channel) => channel.runtime !== "supported");
const dmPolicyLabels: Record<string, string> = {
  allowlist: "Allowlist",
  pairing: "Pairing",
  open: "Open",
  deny: "Deny",
};
const flow = [
  { step: "01", title: "Platform adapter", desc: "Receives the platform event and emits a channel inbound message." },
  { step: "02", title: "Ingress admission", desc: "Evaluates access policy and decides whether to dispatch, handle, observe, or drop the message." },
  { step: "03", title: "Agent dispatch", desc: "Allowed messages reach the same permissioned agent flow used by the desktop chat." },
  { step: "04", title: "Channel reply", desc: "The result routes back through the adapter to the original conversation and thread." },
];
---

<ProductPageLayout
  description="Reach your desktop assistant from Telegram and Discord, with per-channel tokens, sender allowlists, and replies delivered to the originating thread."
  image="/og/kucedr-personal-ai-assistant.png"
  title="Channels"
>
  <ProductPageHero
    accent="where you are."
    description="Messages from connected platforms run the same permissioned Kucedr agent turn, then return to the conversation and thread where the request started."
    eyebrow="Channels"
    jumpLabel="Channel page sections"
    jumps={[
      { href: "#supported", icon: "RadioTower", label: "Supported" },
      { href: "#planned", icon: "Clock", label: "Coming soon" },
      { href: "#flow", icon: "Workflow", label: "Inbound flow" },
    ]}
    stats={[
      { value: channels.length, label: "Channel adapters" },
      { value: supported.length, label: "Supported now" },
      { value: 4, label: "DM policy modes" },
    ]}
    statsLabel="Channel support summary"
    title="Chat with Kucedr where you are."
  />

  <section class="catalog-section" id="supported">
    <div class="shell">
      <header class="catalog-section__head">
        <div class="catalog-section__title">
          <span class="catalog-section-tag">01 / Available now</span>
          <h2>Connected conversations.</h2>
        </div>
        <p class="catalog-section__aside">Each supported channel keeps its own token, sender rules, reply model, and destination while sharing Kucedr's core agent flow.</p>
      </header>
      <div class="channel-product-grid">
        {supported.map((channel, index) => (
          <article class="channel-product-card is-live">
            <div class="channel-product-card__top">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <i><Icon name="MessageSquare" size={18} /></i>
              <small>Supported</small>
            </div>
            <h3>{channel.name}</h3>
            <p>{channel.description}</p>
            <dl>
              <div><dt>DM default</dt><dd>{dmPolicyLabels[channel.dmPolicy] ?? channel.dmPolicy}</dd></div>
              <div><dt>Threads</dt><dd>{channel.threadSupport ? "Supported" : "Not supported"}</dd></div>
            </dl>
            <div class="product-chip-list">{channel.configFields.map((field) => <span>{field}</span>)}</div>
            {channel.docsUrl && <a href={channel.docsUrl} target="_blank" rel="noopener noreferrer">Official docs <Icon name="ArrowRight" size={13} /></a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="catalog-section is-tinted" id="planned">
    <div class="shell">
      <header class="catalog-section__head">
        <div class="catalog-section__title">
          <span class="catalog-section-tag">02 / Product direction</span>
          <h2>More places to reach Kucedr.</h2>
        </div>
        <p class="catalog-section__aside">Planned adapters follow the same identity, access-policy, thread-routing, and provider boundaries as supported channels.</p>
      </header>
      <div class="channel-product-grid">
        {planned.map((channel, index) => (
          <article class="channel-product-card is-planned">
            <div class="channel-product-card__top">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <i><Icon name="Clock" size={18} /></i>
              <small>Coming soon</small>
            </div>
            <h3>{channel.name}</h3>
            <p>{channel.description}</p>
            <dl>
              <div><dt>Planned DM default</dt><dd>{dmPolicyLabels[channel.dmPolicy] ?? channel.dmPolicy}</dd></div>
              <div><dt>Threads</dt><dd>{channel.threadSupport ? "Planned" : "Not planned"}</dd></div>
            </dl>
            <div class="product-chip-list">{channel.configFields.map((field) => <span>{field}</span>)}</div>
            {channel.docsUrl && <a href={channel.docsUrl} target="_blank" rel="noopener noreferrer">Platform docs <Icon name="ArrowRight" size={13} /></a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="catalog-section" id="flow">
    <div class="shell">
      <header class="catalog-section__head">
        <div class="catalog-section__title">
          <span class="catalog-section-tag">03 / Inbound flow</span>
          <h2>One controlled round trip.</h2>
        </div>
        <p class="catalog-section__aside">A channel request crosses explicit admission and dispatch boundaries before Kucedr sends anything back.</p>
      </header>
      <ol class="product-step-list product-step-list--four">
        {flow.map((item) => <li><span>{item.step}</span><div><h3>{item.title}</h3><p>{item.desc}</p></div></li>)}
      </ol>
    </div>
  </section>

  <CTASection
    eyebrow="Channel access"
    title="Every channel starts with access control."
    description="Use allowlists, pairing, open, or deny policies so you decide who can message Kucedr from outside the app."
  />
</ProductPageLayout>
