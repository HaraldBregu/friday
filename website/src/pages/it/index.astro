---
import KucedrLandingPage from "../../components/KucedrLandingPage.astro";
import landing from "../../data/kucedr-landing-it.json";
import { getLocaleContent } from "../../i18n";
import { buildHomepageStructuredData } from "../../lib/structured-data";
import Layout from "../../layouts/Layout.astro";

const locale = "it";
const { site } = getLocaleContent(locale);
const title = "Kucedr: il tuo assistente AI personale per desktop";
const description = "Kucedr lavora sui tuoi file, cerca sul web e usa gli strumenti che scegli. Tu controlli provider, dati e autorizzazioni.";
const siteBaseUrl = Astro.site ?? new URL(site.url);
const structuredData = buildHomepageStructuredData({
  description,
  featureNames: landing.capabilities.map((capability) => capability.label),
  locale,
  siteBaseUrl,
  tagline: site.tagline,
});
---

<Layout
  alternatePath="/"
  bodyClass="kucedr-landing-page"
  description={description}
  exactTitle
  footerVariant="landing"
  hideBackgroundEffects
  hideHeader
  image="/og/kucedr-personal-ai-assistant.png"
  locale={locale}
  ogDescription={description}
  ogTitle={title}
  structuredData={structuredData}
  title={title}
>
  <KucedrLandingPage locale={locale} />
</Layout>
