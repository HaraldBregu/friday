---
import Header from "../components/Header.astro";
import KucedrLandingNav from "../components/KucedrLandingNav.astro";
import Footer from "../components/Footer.astro";
import Starfield from "../components/Starfield.astro";
import Daylight from "../components/Daylight.astro";
import { getAlternateLinks, getLocaleContent, localeMeta, normalizeLocale, type Locale } from "../i18n";
import { socialImageForPath, socialImages } from "../lib/social-images";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
  hideFooter?: boolean;
  hideHeader?: boolean;
  hideBackgroundEffects?: boolean;
  bodyClass?: string;
  exactTitle?: boolean;
  footerVariant?: "default" | "landing";
  headerVariant?: "default" | "landing";
  wide?: boolean;
  locale?: Locale;
  alternatePath?: string;
  structuredData?: Record<string, unknown>;
}

const locale = normalizeLocale(Astro.props.locale);
const { site, ui } = getLocaleContent(locale);
const {
  title = site.name,
  description = site.description,
  image = socialImages.default.path,
  imageAlt,
  canonical,
  noindex = false,
  ogTitle,
  ogDescription,
  ogType = "website",
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  hideFooter = false,
  hideHeader = false,
  hideBackgroundEffects = false,
  bodyClass,
  exactTitle = false,
  footerVariant = "default",
  headerVariant = "default",
  wide = false,
  alternatePath,
  structuredData,
} = Astro.props;

const pageTitle = exactTitle ? title : title === site.name ? `${site.name} - ${site.tagline}` : `${title} | ${site.name}`;
const siteBaseUrl = Astro.site ?? new URL(site.url);
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteBaseUrl).toString();
const socialImage = socialImageForPath(image, locale);
const imageUrl = new URL(socialImage.path, siteBaseUrl).toString();
const openGraphTitle = ogTitle ?? pageTitle;
const openGraphDescription = ogDescription ?? description;
const openGraphImageAlt = imageAlt ?? socialImage.alt;
const openGraphLocale = locale === "it" ? "it_IT" : "en_US";
const alternateOpenGraphLocale = locale === "it" ? "en_US" : "it_IT";
const alternateLinks = alternatePath ? getAlternateLinks(alternatePath, siteBaseUrl) : [];
const defaultStructuredData = noindex
  ? undefined
  : {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ImageObject",
          "@id": `${canonicalUrl}#primaryimage`,
          url: imageUrl,
          contentUrl: imageUrl,
          width: socialImage.width,
          height: socialImage.height,
          encodingFormat: socialImage.type,
          caption: openGraphImageAlt,
          inLanguage: localeMeta[locale].hreflang,
          representativeOfPage: true,
        },
        {
          "@type": "WebPage",
          "@id": `${canonicalUrl}#webpage`,
          url: canonicalUrl,
          name: pageTitle,
          description,
          inLanguage: localeMeta[locale].hreflang,
          isPartOf: { "@id": new URL("/#website", siteBaseUrl).toString() },
          primaryImageOfPage: { "@id": `${canonicalUrl}#primaryimage` },
        },
      ],
    };
const resolvedStructuredData = structuredData ?? defaultStructuredData;
const serializedStructuredData = resolvedStructuredData
  ? JSON.stringify(resolvedStructuredData).replace(/</g, "\\u003c")
  : undefined;
---

<!doctype html>
<html data-theme="dark" lang={localeMeta[locale].hreflang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <meta content="#050505" data-theme-color name="theme-color" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          stored = null;
        }
        const theme = stored === "light" || stored === "dark"
          ? stored
          : window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <meta content={description} name="description" />
    <meta
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
      name="robots"
    />
    <link href={canonicalUrl} rel="canonical" />
    {
      alternateLinks.map((link) => (
        <link href={link.url} hreflang={link.hreflang} rel="alternate" />
      ))
    }
    {
      alternateLinks.length > 0 ? (
        <link href={alternateLinks[0].url} hreflang="x-default" rel="alternate" />
      ) : null
    }
    <link href="/icon-rounded.png" rel="icon" type="image/png" />
    <link href="/icon-rounded.png" rel="apple-touch-icon" />
    <meta content={site.name} property="og:site_name" />
    <meta content={openGraphTitle} property="og:title" />
    <meta content={openGraphDescription} property="og:description" />
    <meta content={canonicalUrl} property="og:url" />
    <meta content={imageUrl} property="og:image" />
    <meta content={imageUrl} property="og:image:url" />
    <meta content={imageUrl} property="og:image:secure_url" />
    <meta content={socialImage.type} property="og:image:type" />
    <meta content={String(socialImage.width)} property="og:image:width" />
    <meta content={String(socialImage.height)} property="og:image:height" />
    <meta content={openGraphImageAlt} property="og:image:alt" />
    <meta content={ogType} property="og:type" />
    <meta content={openGraphLocale} property="og:locale" />
    <meta content={alternateOpenGraphLocale} property="og:locale:alternate" />
    {
      ogType === "article" ? (
        <>
          {publishedTime ? (
            <meta content={publishedTime.toISOString()} property="article:published_time" />
          ) : null}
          {modifiedTime ? (
            <meta content={modifiedTime.toISOString()} property="article:modified_time" />
          ) : null}
          {author ? <meta content={author} property="article:author" /> : null}
          {tags.map((tag) => <meta content={tag} property="article:tag" />)}
        </>
      ) : null
    }
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="@HaraldBregu" name="twitter:site" />
    <meta content="@HaraldBregu" name="twitter:creator" />
    <meta content={openGraphTitle} name="twitter:title" />
    <meta content={openGraphDescription} name="twitter:description" />
    <meta content={canonicalUrl} name="twitter:url" />
    <meta content={imageUrl} name="twitter:image" />
    <meta content={openGraphImageAlt} name="twitter:image:alt" />
    {
      serializedStructuredData ? (
        <script is:inline type="application/ld+json" set:html={serializedStructuredData}></script>
      ) : null
    }
  </head>
  <body class:list={[wide && "layout--wide", bodyClass]}>
    <a class="skip-link" href="#content">{ui.skipToContent}</a>
    {hideBackgroundEffects ? null : <Starfield />}
    {hideBackgroundEffects ? null : <Daylight />}
    {hideHeader ? null : headerVariant === "landing" ? <KucedrLandingNav home={false} locale={locale} /> : <Header alternatePath={alternatePath} locale={locale} />}
    <main id="content">
      <slot />
    </main>
    {hideFooter ? null : <Footer alternatePath={alternatePath} locale={locale} variant={footerVariant} />}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = document.querySelectorAll("[data-theme-toggle]");
        const themeColor = document.querySelector("[data-theme-color]");
        const media = window.matchMedia("(prefers-color-scheme: light)");

        const update = (theme, persist = true) => {
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          if (themeColor) themeColor.setAttribute("content", theme === "light" ? "#f7f6f3" : "#050505");
          buttons.forEach((button) => button.setAttribute("aria-pressed", theme === "light" ? "true" : "false"));
          if (!persist) return;
          try {
            localStorage.setItem("theme", theme);
          } catch {
            // The visible theme still changes when storage is unavailable.
          }
        };

        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            update(root.dataset.theme === "light" ? "dark" : "light");
          });
        });

        update(root.dataset.theme === "light" ? "light" : "dark", false);

        media.addEventListener("change", (event) => {
          let stored;
          try {
            stored = localStorage.getItem("theme");
          } catch {
            stored = null;
          }
          if (stored !== "light" && stored !== "dark") update(event.matches ? "light" : "dark", false);
        });

        window.addEventListener("storage", (event) => {
          if (event.key === "theme" && (event.newValue === "light" || event.newValue === "dark")) {
            update(event.newValue, false);
          }
        });
      })();
    </script>
  </body>
</html>
