---
import ProductPageLayout from "./ProductPageLayout.astro";
import Icon from "../components/Icon.astro";
import { buildBlogPostStructuredData } from "../lib/structured-data";

const { post, readingTime, slug = post.id.replace(/\.mdx?$/, "") } = Astro.props;

const path = `/blog/${slug}`;
const siteBaseUrl = Astro.site ?? new URL("https://kucedr.haraldbregu.com");
const structuredData = buildBlogPostStructuredData({
  author: post.data.author,
  description: post.data.description,
  modifiedDate: post.data.updatedDate,
  path,
  publishedDate: post.data.pubDate,
  siteBaseUrl,
  tags: post.data.tags,
  title: post.data.title,
});
---

<ProductPageLayout
  title={post.data.title}
  description={post.data.description}
  canonical={path}
  image="/og/kucedr-journal-notes-for-builders.png"
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  author={post.data.author}
  tags={post.data.tags}
  structuredData={structuredData}
>
  <article class="product-article">
    <header class="product-article-hero">
      <div class="shell product-article-hero__inner">
        <a class="product-back-link" href="/blog">
          <Icon name="ArrowRight" size={15} />
          Back to blog
        </a>
        <p class="catalog-eyebrow">{post.data.author} / {readingTime} min read</p>
        <h1>{post.data.title}</h1>
        <p class="product-article-hero__lede">{post.data.description}</p>
        <div class="product-article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {
            post.data.pubDate.toLocaleDateString("en", {
              month: "long",
              day: "numeric",
              year: "numeric",
            })
          }
        </time>
        <span>{post.data.tags.join(", ")}</span>
        </div>
      </div>
    </header>
    <div class="catalog-section">
      <div class="shell product-article-body">
        <slot />
      </div>
    </div>
  </article>
</ProductPageLayout>
