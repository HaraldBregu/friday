---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import landingEn from "../data/kucedr-landing.json";
import landingIt from "../data/kucedr-landing-it.json";
import { localizedRoutePath, normalizeLocale, type Locale } from "../i18n";

interface Props {
  home?: boolean;
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const landing = locale === "it" ? landingIt : landingEn;
const { links, navigation } = landing;
const home = Astro.props.home ?? true;
const homePath = localizedRoutePath("/", locale);
const labels = locale === "it"
  ? { download: "Scarica", menu: "Apri il menu di navigazione", product: "Prodotto", explore: "Esplora", overview: "Panoramica", primary: "Navigazione principale", sections: "Sezioni della pagina", home: "Pagina iniziale di Kucedr", theme: "Cambia tema" }
  : { download: "Download", menu: "Open navigation menu", product: "Product", explore: "Explore", overview: "Overview", primary: "Primary navigation", sections: "Page sections", home: "Kucedr home", theme: "Toggle color theme" };
const routeHref = (path: string) => localizedRoutePath(path, locale);
const sectionHref = (href: string) => href.startsWith("#")
  ? !home ? `${homePath}${href}` : href
  : routeHref(href);
const normalizePath = (path: string) => path.length > 1 ? path.replace(/\/$/, "") : path;
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => {
  if (href.startsWith("#")) return false;
  const path = normalizePath(href);
  return currentPath === path || (path !== "/" && currentPath.startsWith(`${path}/`));
};
const itemLabel = (item: (typeof navigation)[number]) => item.href === "#product" ? labels.overview : item.label;
const extensionsItem = navigation.find((item) => item.href.includes("extensions"));
const productItems = navigation.filter((item) => item.href.startsWith("#") && item.href !== "#providers" && item.href !== "#extensions");
const exploreItems = locale === "it"
  ? [
      { label: "Strumenti", href: routeHref("/tools") },
      { label: "Provider", href: routeHref("/providers") },
      { label: "Integrazioni", href: routeHref("/integrations") },
      { label: "Canali", href: routeHref("/channels") },
      { label: "Operatori", href: routeHref("/operators") },
      { label: "Soluzioni", href: routeHref("/solutions") },
      { label: "Community", href: routeHref("/community") },
      { label: "Versioni", href: routeHref("/releases") },
      { label: "Blog", href: routeHref("/blog") },
    ]
  : [
      { label: "Tools", href: "/tools" },
      { label: "Providers", href: "/providers" },
      { label: "Integrations", href: "/integrations" },
      { label: "Channels", href: "/channels" },
      { label: "Operators", href: "/operators" },
      { label: "Solutions", href: "/solutions" },
      { label: "Community", href: "/community" },
      { label: "Releases", href: "/releases" },
      { label: "Blog", href: "/blog" },
    ];
const navigationGroups = [
  { label: labels.product, items: productItems, current: currentPath === normalizePath(homePath) },
  { label: labels.explore, items: exploreItems, current: exploreItems.some((item) => isCurrent(item.href)) },
].filter((group) => group.items.length > 0);
const docsItem = navigation.find((item) => item.href === "/docs");
---

<header class="fr-nav-wrap">
  <nav aria-label={labels.primary} class="fr-nav">
    <a class="fr-brand" href={home ? "#product" : `${homePath}#product`} aria-label={labels.home}>
      <img src="/icon-rounded.png" alt="" width="34" height="34" />
      <span>Kucedr</span>
    </a>

    <div class="fr-nav__links" aria-label={labels.sections}>
      {navigationGroups.map((group) => (
        <details class="fr-nav__group fr-nav-dropdown" data-fr-nav-dropdown>
          <summary class:list={{ "is-current": group.current }}>
            {group.label}
            <Icon name="ChevronDown" size={14} />
          </summary>
          <div class="fr-nav-dropdown__panel">
            {group.items.map((item) => <a aria-current={isCurrent(item.href) ? "page" : undefined} href={sectionHref(item.href)}>{itemLabel(item as (typeof navigation)[number])}</a>)}
          </div>
        </details>
      ))}
      {extensionsItem && <a class="fr-nav__direct" aria-current={isCurrent(extensionsItem.href) ? "page" : undefined} href={sectionHref(extensionsItem.href)}>{extensionsItem.label}</a>}
      {docsItem && <a class="fr-nav__direct" aria-current={isCurrent(docsItem.href) ? "page" : undefined} href={sectionHref(docsItem.href)}>{docsItem.label}</a>}
    </div>

    <div class="fr-nav__actions">
      <ThemeToggle label={labels.theme} />
      <a class="fr-nav__github" href={links.github} target="_blank" rel="noopener noreferrer">
        <Icon name="Github" size={16} />
        <span>GitHub</span>
      </a>
      <a class="fr-button fr-button--compact" href={links.download} target="_blank" rel="noopener noreferrer">
        <Icon name="Download" size={15} />
        {labels.download}
      </a>

      <details class="fr-mobile-menu" data-fr-menu>
        <summary aria-label={labels.menu}>
          <Icon class="fr-mobile-menu__open" name="Menu" size={20} />
          <Icon class="fr-mobile-menu__close" name="X" size={20} />
        </summary>
        <div class="fr-mobile-menu__panel">
          {navigationGroups.map((group) => (
            <details class="fr-mobile-menu__group">
              <summary class:list={{ "is-current": group.current }}>
                {group.label}
                <Icon name="ChevronDown" size={16} />
              </summary>
              <div>
                {group.items.map((item) => <a aria-current={isCurrent(item.href) ? "page" : undefined} href={sectionHref(item.href)}>{itemLabel(item as (typeof navigation)[number])}</a>)}
              </div>
            </details>
          ))}
          {extensionsItem && <a class="fr-mobile-menu__direct" aria-current={isCurrent(extensionsItem.href) ? "page" : undefined} href={sectionHref(extensionsItem.href)}>{extensionsItem.label}</a>}
          {docsItem && <a class="fr-mobile-menu__direct" aria-current={isCurrent(docsItem.href) ? "page" : undefined} href={sectionHref(docsItem.href)}>{docsItem.label}</a>}
          <a class="fr-mobile-menu__github" href={links.github} target="_blank" rel="noopener noreferrer">
            GitHub
            <Icon name="ArrowUpRight" size={15} />
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const menu = document.querySelector("[data-fr-menu]");
    const dropdowns = [...document.querySelectorAll("[data-fr-nav-dropdown]")];

    menu?.addEventListener("click", (event) => {
      if (event.target.closest("a")) menu.open = false;
    });

    dropdowns.forEach((dropdown) => {
      dropdown.addEventListener("toggle", () => {
        if (!dropdown.open) return;
        dropdowns.forEach((other) => {
          if (other !== dropdown) other.open = false;
        });
      });
    });

    document.addEventListener("click", (event) => {
      if (event.target.closest("[data-fr-nav-dropdown]")) return;
      dropdowns.forEach((dropdown) => { dropdown.open = false; });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      dropdowns.forEach((dropdown) => { dropdown.open = false; });
    });
  })();
</script>
