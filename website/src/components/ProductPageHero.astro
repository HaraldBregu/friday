---
import Icon from "./Icon.astro";

interface Jump {
  href: string;
  icon: string;
  label: string;
}

interface Stat {
  value: string | number;
  label: string;
}

interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description: string;
  jumps?: Jump[];
  jumpLabel?: string;
  stats?: Stat[];
  statsLabel?: string;
}

const {
  eyebrow,
  title,
  accent,
  description,
  jumps = [],
  jumpLabel = "Page sections",
  stats = [],
  statsLabel = "Page summary",
} = Astro.props;
const accentIndex = accent ? title.indexOf(accent) : -1;
const titleBefore = accentIndex >= 0 ? title.slice(0, accentIndex) : title;
const titleAfter = accentIndex >= 0 && accent ? title.slice(accentIndex + accent.length) : "";
---

<section class="catalog-hero">
  <div class="shell catalog-hero__inner">
    <p class="catalog-eyebrow">{eyebrow}</p>
    <h1>
      {titleBefore}
      {accentIndex >= 0 && accent ? <em>{accent}</em> : null}
      {titleAfter}
    </h1>
    <p class="catalog-hero__lede">{description}</p>

    {jumps.length > 0 && (
      <nav class="catalog-jump" aria-label={jumpLabel}>
        {jumps.map((jump) => (
          <a href={jump.href}>
            <Icon name={jump.icon} size={15} />
            {jump.label}
          </a>
        ))}
      </nav>
    )}

    {stats.length > 0 && (
      <div class="catalog-summary" aria-label={statsLabel}>
        {stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
      </div>
    )}
  </div>
</section>
