---
import socialLinks from "../data/social-links.json";
import Icon from "./Icon.astro";

const githubUrl = socialLinks.find((link) => link.label === "GitHub")?.url ?? "https://github.com/replace-me/kucedr";
const releaseBaseUrl = `${githubUrl}/releases/latest/download`;
const downloadOptions = [
  { label: "macOS", icon: "Apple", url: `${releaseBaseUrl}/Kucedr-mac.dmg` },
  { label: "Linux", icon: "TerminalSquare", url: `${releaseBaseUrl}/Kucedr-linux.AppImage` },
  { label: "Windows", icon: "MonitorDown", url: `${releaseBaseUrl}/Kucedr-windows.exe` },
];

const trustMarks = ["OpenAI", "Anthropic", "Google", "Telegram", "GitHub", "Cron", "MCP"];
---

<section class="hero hero--reference" id="product">
  <div class="hero-stars hero-stars--far" aria-hidden="true"></div>
  <div class="hero-stars hero-stars--near" aria-hidden="true"></div>
  <div class="shell hero-reference__inner">
    <div class="hero-reference__copy">
      <h1>Kucedr</h1>
      <p>
        A local-first desktop AI copilot for chat, tools, connected apps,
        scheduled tasks, and voice-assisted workflows.
      </p>
    </div>

    <div class="desktop-chat" aria-label="Kucedr desktop app chat preview" data-desktop-chat>
      <div class="desktop-chat__bar">
        <div class="desktop-chat__lights" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <strong>Kucedr</strong>
        <Icon name="UserRound" size={19} />
      </div>

      <div class="desktop-chat__body" data-chat-messages>
        <div class="desktop-chat__user-bubble">Hello</div>

        <div class="desktop-chat__assistant">
          <span class="assistant-orb" aria-hidden="true"></span>
          <strong>Kucedr</strong>
        </div>

        <div class="desktop-chat__assistant-message">Hello! How can I help?</div>
      </div>

      <form class="desktop-chat__composer" aria-label="Kucedr prompt composer" data-chat-form>
        <button aria-label="Add attachment" data-add-attachment type="button">
          <Icon name="Plus" size={22} />
        </button>
        <input aria-label="Ask Kucedr" autocomplete="off" data-chat-input placeholder="Ask anything" type="text" />
        <button aria-label="Dictate with microphone" data-mic-toggle type="button">
          <Icon name="Mic" size={21} />
        </button>
        <button aria-label="Send message" class="desktop-chat__voice" type="submit">
          <Icon name="AudioLines" size={22} />
        </button>
      </form>
    </div>

    <div class="hero-reference__actions">
      <details class="download-menu download-menu--reference">
        <summary class="button button--primary download-menu__trigger">
          <Icon name="Download" size={18} />
          Download Kucedr
          <Icon class="download-menu__chevron" name="ChevronDown" size={16} />
        </summary>
        <div class="download-menu__panel">
          {
            downloadOptions.map((option) => (
              <a href={option.url}>
                <Icon name={option.icon} size={18} />
                <span>{option.label}</span>
              </a>
            ))
          }
        </div>
      </details>
      <a class="button button--ghost" href="#product">Preview workflow</a>
    </div>

    <div class="hero-trust" aria-label="Representative Kucedr surfaces">
      {trustMarks.map((mark) => <span>{mark}</span>)}
    </div>
  </div>
</section>

<script>
  const chat = document.querySelector("[data-desktop-chat]");
  const form = chat?.querySelector("[data-chat-form]");
  const input = chat?.querySelector("[data-chat-input]");
  const messages = chat?.querySelector("[data-chat-messages]");
  const addAttachment = chat?.querySelector("[data-add-attachment]");
  const micToggle = chat?.querySelector("[data-mic-toggle]");

  const addAssistantReply = (text) => {
    const assistant = document.createElement("div");
    assistant.className = "desktop-chat__assistant";
    assistant.innerHTML = '<span class="assistant-orb" aria-hidden="true"></span><strong>Kucedr</strong>';

    const message = document.createElement("div");
    message.className = "desktop-chat__assistant-message";
    message.textContent = text;

    messages?.append(assistant, message);
    messages?.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
  };

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(input instanceof HTMLInputElement) || !messages) return;

    const value = input.value.trim() || "Hello";
    const userBubble = document.createElement("div");
    userBubble.className = "desktop-chat__user-bubble";
    userBubble.textContent = value;
    messages.append(userBubble);
    input.value = "";
    messages.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });

    window.setTimeout(() => {
      addAssistantReply("I can help with chat, files, tools, providers, channels, or scheduled work.");
    }, 260);
  });

  addAttachment?.addEventListener("click", () => {
    addAssistantReply("Attach a file or audio note and I will keep the action visible before using tools.");
  });

  micToggle?.addEventListener("click", () => {
    chat?.toggleAttribute("data-listening");
    if (input instanceof HTMLInputElement) {
      input.placeholder = chat?.hasAttribute("data-listening") ? "Listening..." : "Ask anything";
      input.focus();
    }
  });
</script>
