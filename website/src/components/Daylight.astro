<div class="daylight" aria-hidden="true">
  <div class="daylight__sky"></div>
  <div class="daylight__halo"></div>
  <div class="daylight__sun"></div>
  <div class="daylight__rays"></div>
  <div class="daylight__ray-particles">
    <div class="rp-ray" style="--ra:-44deg">
      <span style="--rp-d:0s"></span>
      <span style="--rp-d:2s"></span>
      <span style="--rp-d:4s"></span>
    </div>
    <div class="rp-ray" style="--ra:-24deg">
      <span style="--rp-d:0.6s"></span>
      <span style="--rp-d:2.8s"></span>
    </div>
    <div class="rp-ray" style="--ra:-6deg">
      <span style="--rp-d:0.2s"></span>
      <span style="--rp-d:2.2s"></span>
      <span style="--rp-d:4.3s"></span>
    </div>
    <div class="rp-ray" style="--ra:14deg">
      <span style="--rp-d:1.1s"></span>
      <span style="--rp-d:3.1s"></span>
    </div>
    <div class="rp-ray" style="--ra:34deg">
      <span style="--rp-d:0.4s"></span>
      <span style="--rp-d:2.5s"></span>
      <span style="--rp-d:4.6s"></span>
    </div>
    <div class="rp-ray" style="--ra:54deg">
      <span style="--rp-d:1.4s"></span>
      <span style="--rp-d:3.4s"></span>
    </div>
  </div>
  <div class="daylight__motes">
    <span style="--mx:12%;--my:22%;--md:18s;--mo:0.55"></span>
    <span style="--mx:28%;--my:54%;--md:24s;--mo:0.65;--mdelay:3s"></span>
    <span style="--mx:45%;--my:38%;--md:20s;--mo:0.5;--mdelay:7s"></span>
    <span style="--mx:62%;--my:71%;--md:22s;--mo:0.6;--mdelay:1.5s"></span>
    <span style="--mx:78%;--my:29%;--md:16s;--mo:0.55;--mdelay:5s"></span>
    <span style="--mx:88%;--my:58%;--md:26s;--mo:0.45;--mdelay:9s"></span>
    <span style="--mx:33%;--my:82%;--md:19s;--mo:0.6;--mdelay:12s"></span>
    <span style="--mx:55%;--my:15%;--md:23s;--mo:0.65;--mdelay:4s"></span>
    <span style="--mx:8%;--my:66%;--md:21s;--mo:0.4;--mdelay:8s"></span>
    <span style="--mx:72%;--my:44%;--md:17s;--mo:0.5;--mdelay:11s"></span>
    <span style="--mx:41%;--my:91%;--md:25s;--mo:0.6;--mdelay:2s"></span>
    <span style="--mx:19%;--my:37%;--md:15s;--mo:0.45;--mdelay:6s"></span>
    <span style="--mx:6%;--my:48%;--md:28s;--mo:0.4;--mdelay:14s"></span>
    <span style="--mx:91%;--my:23%;--md:20s;--mo:0.55;--mdelay:10s"></span>
  </div>
</div>
