---
import { getLocaleContent, normalizeLocale, type Locale } from "../i18n";
import CTASection from "./CTASection.astro";
import Icon from "./Icon.astro";
import ProductPageHero from "./ProductPageHero.astro";
import ProductPageLayout from "../layouts/ProductPageLayout.astro";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const { operators, operatorsPage } = getLocaleContent(locale);
const statusLabel: Record<string, string> = {
  implemented: operatorsPage.statusLabel.implemented,
  "pending-runtime": operatorsPage.statusLabel["pending-runtime"],
  placeholder: operatorsPage.statusLabel.placeholder,
};
const liveCount = operators.filter((operator) => operator.status === "implemented").length;
const copy = locale === "it"
  ? {
      accent: "workflow.",
      title: "Una funzione chiara per ogni attività.",
      description: "Chat, strumenti, voce, media, automazioni e memoria restano separati. Ogni funzione ha provider, modello e controlli dedicati.",
      catalog: "Funzioni disponibili",
      live: "Funzioni attive",
      providers: "Provider configurabili",
      sectionTag: "01 / Funzioni dell'assistente",
      sectionTitle: "Strumenti diversi, un solo assistente.",
      sectionDescription: "Kucedr combina le funzioni necessarie quando una richiesta richiede più passaggi.",
    }
  : {
      accent: "workflow.",
      title: "One clear capability for every workflow.",
      description: "Kucedr separates conversation, tools, voice, media, automation, and memory into legible capabilities, each with its own provider, model, and boundaries.",
      catalog: "Workflow catalog",
      live: "Live workflows",
      providers: "Configurable providers",
      sectionTag: "01 / Assistant capabilities",
      sectionTitle: "Distinct jobs. One assistant.",
      sectionDescription: "Each workflow keeps a clear purpose and composes with the others when a request needs more than one step.",
    };
---

<ProductPageLayout
  alternatePath="/operators"
  description={operatorsPage.description}
  image="/og/kucedr-personal-ai-assistant.png"
  locale={locale}
  title={operatorsPage.title}
>
  <ProductPageHero
    accent={copy.accent}
    description={copy.description}
    eyebrow={operatorsPage.eyebrow}
    jumps={[{ href: "#capabilities", icon: "Workflow", label: copy.catalog }]}
    stats={[
      { value: operators.length, label: copy.catalog },
      { value: liveCount, label: copy.live },
      { value: locale === "it" ? "Scelta" : "Choice", label: copy.providers },
    ]}
    statsLabel={copy.catalog}
    title={copy.title}
  />

  <section class="catalog-section" id="capabilities">
    <div class="shell">
      <header class="catalog-section__head">
        <div class="catalog-section__title">
          <span class="catalog-section-tag">{copy.sectionTag}</span>
          <h2>{copy.sectionTitle}</h2>
        </div>
        <p class="catalog-section__aside">{copy.sectionDescription}</p>
      </header>

      <div class="operator-product-grid">
        {operators.map((operator, index) => (
          <article class="operator-product-card">
            <div class="operator-product-card__top">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <i><Icon name={operator.icon} size={18} /></i>
              <small class:list={{ "is-live": operator.status === "implemented" }}>{statusLabel[operator.status] ?? operator.status}</small>
            </div>
            <h2>{operator.name}</h2>
            <p>{operator.description}</p>
            <ul>
              {operator.highlights.map((highlight) => <li><Icon name="Check" size={14} />{highlight}</li>)}
            </ul>
            <footer>
              <span>{operatorsPage.supportedProviders}</span>
              <p>{operator.providers.join(" · ")}</p>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    locale={locale}
    eyebrow={operatorsPage.ctaEyebrow}
    title={operatorsPage.ctaTitle}
    description={operatorsPage.ctaDescription}
  />
</ProductPageLayout>
