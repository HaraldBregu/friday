---
import Icon from "./Icon.astro";

interface ExtensionScreen {
  id: "workspace" | "design" | "coding";
  icon: string;
  title: string;
  description: string;
  status: string;
  meta: string;
  items: string[];
  root?: string;
  files?: string[];
  document?: {
    name: string;
    path: string;
    title: string;
    summary: string;
    sectionTitle: string;
    saved: string;
    save: string;
    itemLabel: string;
    detailLabel: string;
    priceLabel: string;
    price: string;
    airlineLabel: string;
    airline: string;
  };
  chat?: {
    userLabel: string;
    agentLabel: string;
    request: string;
    response: string;
    followUp: string;
    finalResponse: string;
    complete: string;
    selectedFile: string;
  };
}

interface Labels {
  windowLabel: string;
  screenLabel: string;
}

interface ChromeLabels {
  history: string;
  profile: string;
}

interface Props {
  screens: ExtensionScreen[];
  labels: Labels;
  chromeLabels: ChromeLabels;
}

const { screens, labels, chromeLabels } = Astro.props;
// Temporarily hide the Design Agent and Coding Agent previews. Keep their data and UI code—do not delete them.
const visibleScreens = screens;
const codingToolDetails = ["src/data/", "npm run build", "landing.json  +8 −8"];
const codingToolIcons = ["ScanText", "TerminalSquare", "Pencil"];
---

<section class="fr-home-extension-gallery" aria-label={labels.windowLabel}>
  <div class="fr-home-extension-gallery__glow" aria-hidden="true"></div>
  <div class="fr-home-extension-gallery__grid">
    {visibleScreens.map((screen, index) => (
      <article class={`fr-home-extension-row is-${screen.id}`}>
        <div
          class={`fr-showcase-app fr-extension-screen is-${screen.id}`}
          aria-label={`${screen.title}: ${labels.screenLabel}`}
        >
        <header class="fr-showcase-app__bar">
          <span class="fr-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <strong class="fr-extension-screen__title">{screen.title}</strong>
          {screen.id === "workspace" ? <span></span> : (
            <span class="fr-showcase-app__actions">
              <i aria-label={chromeLabels.history}><Icon name="History" size={15} /></i>
              <i aria-label={chromeLabels.profile}><Icon name="UserRound" size={15} /></i>
            </span>
          )}
        </header>

        <div class="fr-showcase-app__body fr-extension-screen__body">
          <div class="fr-extension-screen__workspace">
            {screen.id === "workspace" && (
              <div class="fr-extension-workspace-ui">
                <aside class="fr-extension-workspace-ui__tree" aria-label={`${screen.title} files`}>
                  <ul>
                    <li class="fr-extension-workspace-ui__agent"><Icon name="ChevronRight" size={11} /><Icon name="Bot" size={13} /><strong>{screen.root}</strong><small>6</small></li>
                    {screen.files?.map((file, index) => (
                      <li class:list={{ "is-open": index === 2 }}>
                        <Icon name={index === 2 ? "ChevronDown" : "ChevronRight"} size={11} />
                        <Icon name={index === 2 ? "FolderOpen" : "Folder"} size={13} />
                        <span>{file.replace(/\/$/, "")}</span>
                        {index === 2 && (
                          <span class="fr-extension-workspace-ui__selected"><Icon name="ScanText" size={12} />{screen.document?.name}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </aside>
                <div class="fr-extension-workspace-ui__board">
                  <div class="fr-extension-workspace-ui__document">
                    <span><Icon name="BookOpen" size={14} /><span><strong>{screen.document?.name}</strong><small>{screen.document?.path}</small></span></span>
                    <span class="fr-extension-workspace-ui__document-actions"><small><Icon name="Check" size={11} />{screen.document?.saved}</small><i><Icon name="Save" size={12} />{screen.document?.save}</i></span>
                  </div>
                  <div class="fr-extension-workspace-ui__content">
                    <h3>{screen.document?.title}</h3>
                    <p>{screen.document?.summary}</p>
                    <hr />
                    <h4>🏆 {screen.document?.sectionTitle}</h4>
                    <table>
                      <thead><tr><th>{screen.document?.itemLabel}</th><th>{screen.document?.detailLabel}</th></tr></thead>
                      <tbody>
                        <tr><td>{screen.document?.priceLabel}</td><td><strong>{screen.document?.price}</strong></td></tr>
                        <tr><td>{screen.document?.airlineLabel}</td><td>{screen.document?.airline}</td></tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            )}

            {screen.id === "design" && (
              <div class="fr-extension-design-ui">
                <div class="fr-extension-design-ui__tools" aria-hidden="true">
                  <span class="is-active"><Icon name="MousePointer2" size={13} /></span>
                  <span><Icon name="Square" size={13} /></span>
                  <span><Icon name="Type" size={13} /></span>
                  <span><Icon name="Pencil" size={13} /></span>
                </div>
                <div class="fr-extension-design-ui__canvas">
                  <div class="fr-extension-design-ui__shapes" aria-hidden="true">
                    <i class="is-one"></i><i class="is-two"></i><i class="is-three"></i>
                  </div>
                  <div class="fr-extension-design-ui__tablet" aria-hidden="true">
                    <div class="fr-extension-design-ui__device-bar"><span></span><i></i><i></i></div>
                    <div class="fr-extension-design-ui__tablet-body">
                      <aside><b></b><i class="is-active"></i><i></i><i></i><i></i><i></i><span></span></aside>
                      <div class="fr-extension-design-ui__tablet-main">
                        <div class="fr-extension-design-ui__tablet-heading">
                          <span><small>KUCEDR</small><strong>LAUNCH</strong></span><i></i>
                        </div>
                        <div class="fr-extension-design-ui__tablet-hero">
                          <i></i><span><b></b><em></em></span><strong>+</strong>
                        </div>
                        <div class="fr-extension-design-ui__tablet-cards">
                          <span><i></i><b></b><em></em></span>
                          <span><i></i><b></b><em></em></span>
                          <span><i></i><b></b><em></em></span>
                        </div>
                        <div class="fr-extension-design-ui__tablet-list">
                          <span><i></i><b></b><em></em></span><span><i></i><b></b><em></em></span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="fr-extension-design-ui__phone" aria-hidden="true">
                    <div class="fr-extension-design-ui__phone-notch"></div>
                    <div class="fr-extension-design-ui__phone-head"><i></i><span><b></b><em></em></span></div>
                    <small>KUCEDR</small>
                    <strong>LAUNCH</strong>
                    <div class="fr-extension-design-ui__phone-card"><i></i><span></span><span></span><b></b></div>
                    <div class="fr-extension-design-ui__phone-list"><span><i></i><b></b></span><span><i></i><b></b></span></div>
                    <div class="fr-extension-design-ui__phone-actions"><i class="is-active"></i><i></i><i></i><i></i></div>
                  </div>
                  <div class="fr-extension-design-ui__layers">
                    {screen.items.map((item, index) => <span class:list={{ "is-active": index === 0 }}><i></i>{item}</span>)}
                  </div>
                </div>
              </div>
            )}

            {screen.id === "coding" && (
              <div class="fr-extension-coding-ui">
                <aside class="fr-extension-coding-ui__sidebar" aria-label={`${screen.title} files`}>
                  <ul>
                    <li class="fr-extension-coding-ui__sidebar-agent"><Icon name="ChevronRight" size={11} /><Icon name="Bot" size={14} /><strong>{screen.root}</strong><small>3</small></li>
                    {screen.files?.map((file, index) => (
                      <li class:list={{ "is-open": index === 2 }}>
                        <Icon name={index === 2 ? "ChevronDown" : "ChevronRight"} size={11} />
                        <Icon name={index === 2 ? "FolderOpen" : "Folder"} size={13} />
                        <span>{file.replace(/\/$/, "")}</span>
                        {index === 2 && <span class="fr-extension-coding-ui__sidebar-selected"><Icon name="ScanText" size={12} />{screen.chat?.selectedFile}</span>}
                      </li>
                    ))}
                  </ul>
                  <div class="fr-extension-coding-ui__sidebar-status"><i></i><span>{screen.status}</span></div>
                </aside>
                <div class="fr-extension-coding-ui__chat" aria-label={screen.title}>
                  <div class="fr-extension-coding-ui__message is-user">
                    <div class="fr-extension-coding-ui__bubble">
                      <small>{screen.chat?.userLabel}</small>
                      <p>{screen.chat?.request}</p>
                    </div>
                  </div>
                  <div class="fr-extension-coding-ui__message is-agent">
                    <div class="fr-extension-coding-ui__assistant-text">
                      <small>{screen.chat?.agentLabel}</small>
                      <p>{screen.chat?.response}</p>
                      <div class="fr-extension-coding-ui__tools">
                        {screen.items.map((item, index) => (
                          <div class={`fr-extension-coding-ui__tool is-${index + 1}`}>
                            <span><Icon name={codingToolIcons[index]} size={13} /></span>
                            <div><strong>{item}</strong><code>{codingToolDetails[index]}</code></div>
                            <Icon name="Check" size={12} />
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                  <div class="fr-extension-coding-ui__message is-user">
                    <div class="fr-extension-coding-ui__bubble">
                      <small>{screen.chat?.userLabel}</small>
                      <p>{screen.chat?.followUp}</p>
                    </div>
                  </div>
                  <div class="fr-extension-coding-ui__message is-agent">
                    <div class="fr-extension-coding-ui__assistant-text">
                      <small>{screen.chat?.agentLabel}</small>
                      <p>{screen.chat?.finalResponse}</p>
                    </div>
                  </div>
                  <div class="fr-extension-coding-ui__change">
                    <Icon name="Pencil" size={13} />
                    <span><strong>{screen.chat?.complete}</strong><small>{screen.status}</small></span>
                    <Icon name="Check" size={13} />
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
        </div>

        <div class="fr-home-extension-row__copy">
          <span class="fr-home-extension-row__icon"><Icon name={screen.icon} size={20} /></span>
          <small>{String(index + 1).padStart(2, "0")} · {labels.screenLabel}</small>
          <h3>{screen.title}</h3>
          <p>{screen.description}</p>
          <span class="fr-home-extension-row__meta"><i></i>{screen.meta}</span>
        </div>
      </article>
    ))}
  </div>
</section>
