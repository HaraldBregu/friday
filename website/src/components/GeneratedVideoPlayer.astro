---
import Icon from "./Icon.astro";

interface Props {
  fullscreenLabel: string;
  label: string;
  muteLabel: string;
  pauseLabel: string;
  playLabel: string;
  seekLabel: string;
  src: string;
  unmuteLabel: string;
}

const {
  fullscreenLabel,
  label,
  muteLabel,
  pauseLabel,
  playLabel,
  seekLabel,
  src,
  unmuteLabel,
} = Astro.props;
---

<figure class="demo-media demo-generated demo-generated--video" aria-label={label}>
  <div
    class="demo-video-player"
    data-demo-video
    data-mute-label={muteLabel}
    data-pause-label={pauseLabel}
    data-play-label={playLabel}
    data-unmute-label={unmuteLabel}
  >
    <video aria-label={label} playsinline preload="auto">
      <source src={src} type="video/mp4" />
    </video>
    <div class="demo-video-player__controls">
      <button aria-label={playLabel} data-video-play type="button">
        <span class="demo-video-player__play-icon"><Icon name="Play" size={22} /></span>
        <span class="demo-video-player__pause-icon"><Icon name="Pause" size={22} /></span>
      </button>
      <input aria-label={seekLabel} data-video-progress max="100" min="0" step="0.1" type="range" value="0" />
      <time data-video-time datetime="PT0S">0:00</time>
      <button aria-label={unmuteLabel} data-video-volume type="button">
        <span class="demo-video-player__volume-icon"><Icon name="Volume2" size={22} /></span>
        <span class="demo-video-player__muted-icon"><Icon name="VolumeX" size={22} /></span>
      </button>
      <button aria-label={fullscreenLabel} data-video-fullscreen type="button"><Icon name="Maximize" size={21} /></button>
    </div>
  </div>
</figure>
