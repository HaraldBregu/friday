---
import KucedrLandingNav from "./KucedrLandingNav.astro";
import HeroAppMockup from "./HeroAppMockup.astro";
import HomeExtensionsApp from "./HomeExtensionsApp.astro";
import Icon from "./Icon.astro";
import landingEn from "../data/kucedr-landing.json";
import landingIt from "../data/kucedr-landing-it.json";
import { normalizeLocale, type Locale } from "../i18n";
import "../styles/kucedr-landing.css";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const landing = locale === "it" ? landingIt : landingEn;
const { home, links } = landing;
const heroAccentPhrase = locale === "it" ? "AI Personale" : "AI Assistant";
const [heroTitleBefore, heroTitleAfter = ""] = home.hero.title.split(heroAccentPhrase);
---

<KucedrLandingNav locale={locale} />

<section class="fr-hero fr-home-hero" id="product" aria-labelledby="hero-title">
  <div class="fr-shell fr-home-hero__layout">
    <div class="fr-home-hero__copy">
      <p class="fr-eyebrow"><span></span>{home.hero.eyebrow}</p>
      <h1 id="hero-title" aria-label={home.hero.title}>
        <span aria-hidden="true">{heroTitleBefore}</span>
        <span class="fr-home-hero__accent" aria-hidden="true">{heroAccentPhrase}</span>
        {locale === "it" ? <br aria-hidden="true" /> : null}
        <span aria-hidden="true">{locale === "it" ? heroTitleAfter.trim() : heroTitleAfter}</span>
      </h1>
      <p class="fr-home-hero__lede">{home.hero.description}</p>
      <div class="fr-actions">
        <a class="fr-button" href={links.download} target="_blank" rel="noopener noreferrer">
          <Icon name="Download" size={17} />
          {home.hero.primary}
        </a>
        <a class="fr-button fr-button--secondary" href="#workflow">
          {home.hero.secondary}
          <Icon name="ArrowRight" size={17} />
        </a>
      </div>
      <p class="fr-home-hero__note">
        <Icon name="ShieldCheck" size={16} />
        {home.hero.note}
      </p>
    </div>

    <HeroAppMockup labels={home.hero.showcase} />

    <ul class="fr-home-signals" aria-label={home.hero.capabilitiesLabel}>
      {home.hero.capabilities.map((capability, index) => (
        <li><span>{String(index + 1).padStart(2, "0")}</span>{capability}</li>
      ))}
    </ul>
  </div>
</section>

<section class="fr-section fr-personal" id="personal" aria-labelledby="personal-title">
  <div class="fr-shell">
    <header class="fr-home-section-head" data-reveal>
      <div>
        <p class="fr-eyebrow"><span></span>{home.personal.eyebrow}</p>
        <h2 id="personal-title">{home.personal.title}</h2>
      </div>
      <div>
        <p>{home.personal.description}</p>
        <strong>{home.personal.outcome}</strong>
      </div>
    </header>

    <ul class="fr-personal-grid" aria-label={home.personal.capabilitiesLabel} data-reveal>
      {home.personal.capabilities.map((capability, index) => (
        <li>
          <div class="fr-personal-card__top">
            <span><Icon name={capability.icon} size={18} /></span>
            <small>{String(index + 1).padStart(2, "0")}</small>
          </div>
          <h3>{capability.title}</h3>
          <p>{capability.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="fr-section fr-workflow-section" id="workflow" aria-labelledby="workflow-title">
  <div class="fr-shell">
    <header class="fr-home-section-head fr-home-section-head--workflow" data-reveal>
      <div>
        <p class="fr-eyebrow"><span></span>{home.workflow.eyebrow}</p>
        <h2 id="workflow-title">{home.workflow.title}</h2>
      </div>
      <p>{home.workflow.description}</p>
    </header>

    <div class="fr-workflow-stage" data-reveal>
      <ol class="fr-workflow-steps" aria-label={home.workflow.stepsLabel}>
        {home.workflow.steps.map((step, index) => (
          <li>
            <div class="fr-workflow-step__meta"><code>{step.number}</code><span><Icon name={step.icon} size={17} /></span></div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            {index < home.workflow.steps.length - 1 && <Icon class="fr-workflow-step__arrow" name="ArrowRight" size={15} />}
          </li>
        ))}
      </ol>

      <aside class="fr-approval-card">
        <span class="fr-approval-card__icon"><Icon name="ShieldCheck" size={20} /></span>
        <div>
          <small>{home.workflow.approvalLabel}</small>
          <h3>{home.workflow.approvalTitle}</h3>
          <p>{home.workflow.approvalDescription}</p>
        </div>
        <ul>
          {home.workflow.approvalActions.map((action, index) => <li class:list={{ "is-primary": index === 1 }}>{action}</li>)}
        </ul>
      </aside>
    </div>
  </div>
</section>

<section class="fr-section fr-home-extensions" id="extensions" aria-labelledby="home-extensions-title">
  <div class="fr-shell">
    <header class="fr-home-section-head" data-reveal>
      <div>
        <p class="fr-eyebrow"><span></span>{home.extensions.eyebrow}</p>
        <h2 id="home-extensions-title">{home.extensions.title}</h2>
      </div>
      <p>{home.extensions.description}</p>
    </header>

    <div data-reveal>
      <HomeExtensionsApp
        screens={home.extensions.screens}
        labels={home.extensions.ui}
        chromeLabels={home.hero.showcase}
      />
    </div>

    <footer class="fr-extension-footer" data-reveal>
      <p>{home.extensions.note}</p>
    </footer>
  </div>
</section>

<section class="fr-section fr-home-control" id="control" aria-labelledby="control-title">
  <div class="fr-shell fr-control-grid">
    <div class="fr-control-copy" data-reveal>
      <p class="fr-eyebrow"><span></span>{home.control.eyebrow}</p>
      <h2 id="control-title">{home.control.title}</h2>
      <p class="fr-control-copy__lede">{home.control.description}</p>
      <ul class="fr-control-principles" aria-label={home.control.pointsLabel}>
        {home.control.points.map((point) => (
          <li>
            <span><Icon name={point.icon} size={17} /></span>
            <div><h3>{point.title}</h3><p>{point.description}</p></div>
          </li>
        ))}
      </ul>
    </div>

    <aside class="fr-permission-panel" data-reveal>
      <div class="fr-permission-panel__bar">
        <span class="fr-window-dots"><i></i><i></i><i></i></span>
        <strong>{home.control.panel.title}</strong>
        <Icon name="LockKeyhole" size={14} />
      </div>
      <div class="fr-permission-panel__body">
        <header><span><Icon name="ShieldCheck" size={19} /></span><div><strong>{home.control.panel.setup}</strong><small>{home.control.panel.subtitle}</small></div></header>
        <ul>
          {home.control.panel.items.map((item) => <li><span><Icon name={item.icon} size={15} />{item.label}</span><small>{item.status}</small></li>)}
        </ul>
        <div class="fr-permission-disclosure">
          <Icon name="Info" size={16} />
          <p><strong>{home.control.disclosureTitle}</strong> {home.control.disclosure}</p>
        </div>
      </div>
    </aside>
  </div>
</section>

<section class="fr-final-cta fr-home-final-cta" aria-labelledby="final-cta-title">
  <div class="fr-home-final-cta__glow" aria-hidden="true"></div>
  <div class="fr-shell fr-home-final-cta__inner" data-reveal>
    <img src="/icon-rounded.png" width="68" height="68" alt="" />
    <p class="fr-eyebrow"><span></span>{home.cta.eyebrow}</p>
    <h2 id="final-cta-title">{home.cta.title}</h2>
    <p>{home.cta.description}</p>
    <div class="fr-actions">
      <a class="fr-button" href={links.download} target="_blank" rel="noopener noreferrer"><Icon name="Download" size={17} />{home.cta.primary}</a>
      <a class="fr-button fr-button--secondary" href={links.github} target="_blank" rel="noopener noreferrer"><Icon name="Github" size={17} />{home.cta.secondary}</a>
    </div>
    <span class="fr-platform-line"><Icon name="Monitor" size={15} />{home.cta.platforms}</span>
  </div>
</section>

<script is:inline>
  (() => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion || !("IntersectionObserver" in window)) return;

    const items = document.querySelectorAll("[data-reveal]");
    document.documentElement.classList.add("fr-motion-ready");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { rootMargin: "0px 0px -8%", threshold: 0.08 });
    items.forEach((item) => observer.observe(item));
  })();
</script>
