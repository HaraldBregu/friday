---
import Icon from "./Icon.astro";

interface Labels {
  windowLabel: string;
  history: string;
  profile: string;
  request: string;
  copy: string;
  edit: string;
  tool: string;
  tokens: string;
  assetAlt: string;
  play: string;
  pause: string;
  seek: string;
  duration: string;
  volume: string;
  mute: string;
  unmute: string;
  fullscreen: string;
  complete: string;
  composer: string;
  attach: string;
  dictate: string;
  voice: string;
  audioPlay: string;
  audioPause: string;
  audioSeek: string;
  audioMute: string;
  audioUnmute: string;
  openingAssistant: string;
  openingUser: string;
  previousRequests: Array<{
    type: "image" | "sound" | "video";
    request: string;
    tool: string;
    result: string;
    meta: string;
    assetAlt?: string;
    src?: string;
  }>;
}

interface Props {
  labels: Labels;
}

const { labels } = Astro.props;
---

<section class="fr-showcase" aria-label={labels.windowLabel}>
  <div class="fr-showcase__glow" aria-hidden="true"></div>
  <div class="fr-showcase-app">
    <header class="fr-showcase-app__bar">
      <span class="fr-window-dots"><i></i><i></i><i></i></span>
      <strong>Kucedr</strong>
      <span class="fr-showcase-app__actions">
        <i aria-label={labels.history}><Icon name="History" size={17} /></i>
        <i aria-label={labels.profile}><Icon name="UserRound" size={17} /></i>
      </span>
    </header>

    <div class="fr-showcase-app__body">
      <div class="fr-showcase-conversation" data-showcase-conversation>
        <div class="fr-showcase-history">
          <div class="fr-showcase-opening">
            <div class="fr-showcase-opening__assistant">
              <img src="/icon-rounded.png" alt="" width="22" height="22" />
              <p>{labels.openingAssistant}</p>
            </div>
            <p class="fr-showcase-opening__user">{labels.openingUser}</p>
          </div>
          {labels.previousRequests.map((item) => (
            <article class={`fr-showcase-history__item is-${item.type}`}>
              <p>{item.request}</p>
              {item.type === "sound" ? (
                <div
                  class="fr-showcase-audio"
                  data-showcase-audio
                  data-mute-label={labels.audioMute}
                  data-pause-label={labels.audioPause}
                  data-play-label={labels.audioPlay}
                  data-unmute-label={labels.audioUnmute}
                >
                  <audio preload="metadata" data-showcase-audio-media>
                    <source src="/demo/sound-1786623297711.mp3" type="audio/mpeg" />
                  </audio>
                  <header>
                    <span><Icon name="AudioLines" size={14} /><strong>{item.tool}</strong><Icon name="Check" size={13} /><small>{item.result}</small></span>
                    <small>{item.meta}<Icon name="ChevronDown" size={13} /></small>
                  </header>
                  <div class="fr-showcase-audio__controls">
                    <button aria-label={labels.audioPlay} type="button" data-audio-play>
                      <span class="fr-showcase-audio-play"><Icon name="Play" size={18} /></span>
                      <span class="fr-showcase-audio-pause"><Icon name="Pause" size={18} /></span>
                    </button>
                    <input aria-label={labels.audioSeek} type="range" min="0" max="100" step="0.1" value="0" data-audio-progress />
                    <time datetime="PT0S" data-audio-time>0:00</time>
                    <button aria-label={labels.audioUnmute} type="button" data-audio-volume>
                      <span class="fr-showcase-audio-volume"><Icon name="Volume2" size={18} /></span>
                      <span class="fr-showcase-audio-muted"><Icon name="VolumeX" size={18} /></span>
                    </button>
                  </div>
                </div>
              ) : (
                <figure class={`fr-showcase-history-media is-${item.type}`}>
                  {item.type === "image" ? (
                    <img src="/demo/image-1783437002924.jpeg" alt={item.assetAlt ?? ""} width="1280" height="720" loading="eager" decoding="async" />
                  ) : (
                    <video aria-label={item.assetAlt ?? ""} muted playsinline preload="auto">
                      <source src={item.src} type="video/mp4" />
                    </video>
                  )}
                </figure>
              )}
            </article>
          ))}
        </div>

        <div class="fr-showcase-request">
          <p>{labels.request}</p>
          <span>
            <i aria-label={labels.copy}><Icon name="Copy" size={14} /></i>
            <i aria-label={labels.edit}><Icon name="Pencil" size={14} /></i>
          </span>
        </div>

        <div class="fr-showcase-tool">
          <span><Icon name="Video" size={14} /><strong>{labels.tool}</strong><Icon name="Check" size={13} /></span>
          <small>{labels.tokens}<Icon name="ChevronDown" size={13} /></small>
        </div>

        <figure
          class="fr-showcase-media"
          data-showcase-video
          data-mute-label={labels.mute}
          data-pause-label={labels.pause}
          data-play-label={labels.play}
          data-unmute-label={labels.unmute}
        >
          <video aria-label={labels.assetAlt} playsinline preload="auto" data-showcase-video-media>
            <source src="/demo/video-1786619185438.mp4" type="video/mp4" />
          </video>
          <div class="fr-showcase-media__controls">
            <button aria-label={labels.play} type="button" data-showcase-play>
              <span class="fr-showcase-play-icon"><Icon name="Play" size={18} /></span>
              <span class="fr-showcase-pause-icon"><Icon name="Pause" size={18} /></span>
            </button>
            <input aria-label={labels.seek} type="range" min="0" max="100" step="0.1" value="0" data-showcase-progress />
            <time datetime="PT0S" data-showcase-time>0:00</time>
            <button aria-label={labels.unmute} type="button" data-showcase-volume>
              <span class="fr-showcase-volume-icon"><Icon name="Volume2" size={18} /></span>
              <span class="fr-showcase-muted-icon"><Icon name="VolumeX" size={18} /></span>
            </button>
            <button aria-label={labels.fullscreen} type="button" data-showcase-fullscreen><Icon name="Maximize" size={17} /></button>
          </div>
        </figure>

        <p class="fr-showcase-complete">{labels.complete}</p>
      </div>

      <div class="fr-showcase-composer">
        <span aria-label={labels.attach}><Icon name="Plus" size={18} /></span>
        <p>{labels.composer}</p>
        <span aria-label={labels.dictate}><Icon name="Mic" size={18} /></span>
        <strong aria-label={labels.voice}><Icon name="AudioLines" size={19} /></strong>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-showcase-conversation]").forEach((conversation) => {
      const scrollToLatest = () => { conversation.scrollTop = conversation.scrollHeight; };
      requestAnimationFrame(scrollToLatest);
      conversation.querySelectorAll("img, video, audio").forEach((media) => {
        media.addEventListener(media.tagName === "IMG" ? "load" : "loadedmetadata", scrollToLatest, { once: true });
      });
    });

    const formatShowcaseTime = (seconds) => {
      const safeSeconds = Number.isFinite(seconds) ? Math.max(0, seconds) : 0;
      const minutes = Math.floor(safeSeconds / 60);
      return `${minutes}:${String(Math.floor(safeSeconds % 60)).padStart(2, "0")}`;
    };

    document.querySelectorAll("[data-showcase-audio]").forEach((player) => {
      const audio = player.querySelector("[data-showcase-audio-media]");
      const playButton = player.querySelector("[data-audio-play]");
      const progress = player.querySelector("[data-audio-progress]");
      const time = player.querySelector("[data-audio-time]");
      const volumeButton = player.querySelector("[data-audio-volume]");
      if (!audio || !playButton || !progress || !time || !volumeButton) return;

      const updatePlayback = () => {
        const percent = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
        progress.value = String(percent);
        progress.style.setProperty("--audio-progress", `${percent}%`);
        time.textContent = formatShowcaseTime(audio.currentTime);
        time.dateTime = `PT${Math.floor(audio.currentTime)}S`;
      };
      const updatePlayState = () => {
        const playing = !audio.paused && !audio.ended;
        player.classList.toggle("is-playing", playing);
        playButton.setAttribute("aria-label", playing ? player.dataset.pauseLabel : player.dataset.playLabel);
      };
      const updateVolumeState = () => {
        const unmuted = !audio.muted && audio.volume > 0;
        player.classList.toggle("is-unmuted", unmuted);
        volumeButton.setAttribute("aria-label", unmuted ? player.dataset.muteLabel : player.dataset.unmuteLabel);
      };

      playButton.addEventListener("click", () => {
        if (audio.paused) {
          document.querySelectorAll("video, audio").forEach((media) => { if (media !== audio) media.pause(); });
          audio.muted = false;
          audio.volume = 1;
          audio.play().catch(() => {});
        } else {
          audio.pause();
        }
        updateVolumeState();
      });
      progress.addEventListener("input", () => {
        if (audio.duration) audio.currentTime = (Number(progress.value) / 100) * audio.duration;
      });
      volumeButton.addEventListener("click", () => {
        audio.muted = !audio.muted;
        if (!audio.muted) audio.volume = 1;
        updateVolumeState();
      });
      audio.addEventListener("play", updatePlayState);
      audio.addEventListener("pause", updatePlayState);
      audio.addEventListener("ended", updatePlayState);
      audio.addEventListener("timeupdate", updatePlayback);
      audio.addEventListener("loadedmetadata", updatePlayback);
      updatePlayState();
      updateVolumeState();
      updatePlayback();
    });

    document.querySelectorAll("[data-showcase-video]").forEach((player) => {
      if (player.dataset.ready === "true") return;
      player.dataset.ready = "true";

      const video = player.querySelector("[data-showcase-video-media]");
      const playButton = player.querySelector("[data-showcase-play]");
      const progress = player.querySelector("[data-showcase-progress]");
      const time = player.querySelector("[data-showcase-time]");
      const volumeButton = player.querySelector("[data-showcase-volume]");
      const fullscreenButton = player.querySelector("[data-showcase-fullscreen]");
      if (!video || !playButton || !progress || !time || !volumeButton || !fullscreenButton) return;

      const updatePlayback = () => {
        const percent = video.duration ? (video.currentTime / video.duration) * 100 : 0;
        progress.value = String(percent);
        progress.style.setProperty("--showcase-progress", `${percent}%`);
        time.textContent = formatShowcaseTime(video.currentTime);
        time.dateTime = `PT${Math.floor(video.currentTime)}S`;
      };

      const updatePlayState = () => {
        const playing = !video.paused && !video.ended;
        player.classList.toggle("is-playing", playing);
        playButton.setAttribute("aria-label", playing ? player.dataset.pauseLabel : player.dataset.playLabel);
      };

      const updateVolumeState = () => {
        const unmuted = !video.muted && video.volume > 0;
        player.classList.toggle("is-unmuted", unmuted);
        volumeButton.setAttribute("aria-label", unmuted ? player.dataset.muteLabel : player.dataset.unmuteLabel);
      };

      playButton.addEventListener("click", () => {
        if (video.paused) {
          document.querySelectorAll("video, audio").forEach((media) => { if (media !== video) media.pause(); });
          video.muted = false;
          video.volume = 1;
          updateVolumeState();
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
      progress.addEventListener("input", () => {
        if (!video.duration) return;
        video.currentTime = (Number(progress.value) / 100) * video.duration;
      });
      volumeButton.addEventListener("click", () => {
        if (video.muted || video.volume === 0) {
          video.muted = false;
          video.volume = 1;
        } else {
          video.muted = true;
        }
        updateVolumeState();
      });
      fullscreenButton.addEventListener("click", () => player.requestFullscreen?.());
      video.addEventListener("play", updatePlayState);
      video.addEventListener("pause", updatePlayState);
      video.addEventListener("ended", updatePlayState);
      video.addEventListener("timeupdate", updatePlayback);
      video.addEventListener("loadedmetadata", updatePlayback);
      video.defaultMuted = false;
      video.muted = false;
      video.volume = 1;
      updatePlayState();
      updateVolumeState();
      updatePlayback();
    });
  })();
</script>
