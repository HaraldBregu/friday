---
import { getLocaleContent, normalizeLocale, type Locale } from "../i18n";
import Icon from "./Icon.astro";

const {
  label,
  class: className = "",
  locale,
} = Astro.props;

const { ui } = getLocaleContent(normalizeLocale(locale as Locale | undefined));
const triggerLabel = label ?? ui.downloadFallbackLabel;
---

<a
  href="https://github.com/HaraldBregu/kucedr/releases"
  target="_blank"
  rel="noopener noreferrer"
  class={`button button--primary ${className}`}
>
  <Icon name="Download" size={18} />
  {triggerLabel}
</a>
