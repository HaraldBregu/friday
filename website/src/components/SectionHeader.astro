---
const {
  eyebrow,
  title,
  description,
  align = "center",
  tone = "light",
} = Astro.props;
---

<div class={`section-header section-header--${align} section-header--${tone}`}>
  {eyebrow ? <p class="section-header__eyebrow">{eyebrow}</p> : null}
  <h2>{title}</h2>
  {description ? <p>{description}</p> : null}
</div>
