---
import Icon from "./Icon.astro";

interface ExtensionItem {
  time: string;
  title: string;
  detail: string;
  state: string;
}

interface ExtensionApp {
  id: string;
  name: string;
  category: string;
  icon: string;
  accent: string;
  headline: string;
  description: string;
  badge: string;
  action: string;
  agentUpdate: string;
  files: string[];
  items: ExtensionItem[];
}

interface Labels {
  agentTitle: string;
  agentQuestion: string;
  agentDescription: string;
  connected: string;
  accessLabel: string;
  access: string[];
  workspaceTitle: string;
  installedLabel: string;
  openLabel: string;
  activityLabel: string;
  agentActivityLabel: string;
  agentFolderLabel: string;
  savedLabel: string;
  saveLabel: string;
  conversationTitle: string;
  modelLabel: string;
  chatUser: string;
  assistantIntro: string;
  toolActivityLabel: string;
  toolReadLabel: string;
  toolActionLabel: string;
  promptPlaceholder: string;
  attachLabel: string;
  sendLabel: string;
}

interface Props {
  apps: ExtensionApp[];
  labels: Labels;
}

const { apps, labels } = Astro.props;
const selectedApp = apps[0]!;
const selectedFile = selectedApp.files[0]!;
---

<div class="fr-extensions-demo" data-extension-demo>
  <section class="fr-extension-agent-window" aria-label={labels.agentTitle}>
    <header class="fr-extension-window-bar">
      <span class="fr-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <strong>{labels.agentTitle}</strong>
      <span></span>
    </header>
    <div class="fr-extension-agent-window__body">
      <header class="fr-extension-chat-head">
        <div>
          <strong>{labels.conversationTitle}</strong>
          <small><i aria-hidden="true"></i><span data-extension-agent-name>{selectedApp.name}</span> · {labels.connected}</small>
        </div>
        <span><Icon name="Sparkles" size={12} />{labels.modelLabel}</span>
      </header>

      <div class="fr-extension-chat-thread">
        <div class="fr-extension-chat-user">{labels.chatUser}</div>
        <article class="fr-extension-chat-assistant">
          <header><img src="/icon-rounded.png" width="24" height="24" alt="" /><strong>{labels.agentTitle}</strong></header>
          <p>{labels.assistantIntro}</p>
          <div class="fr-extension-chat-tools" aria-label={labels.toolActivityLabel}>
            <div class="fr-extension-chat-tools__head"><Icon name="Wrench" size={13} /><strong>{labels.toolActivityLabel}</strong><Icon name="ChevronDown" size={12} /></div>
            <div class="fr-extension-chat-tool"><Icon name="ScanText" size={13} /><span><strong>{labels.toolReadLabel}</strong><small data-extension-agent-file>extensions/{selectedApp.id}/{selectedFile}</small></span><Icon name="Check" size={12} /></div>
            <div class="fr-extension-chat-tool"><Icon name="CalendarDays" size={13} /><span><strong>{labels.toolActionLabel}</strong><small>{labels.access.join(" · ")}</small></span><Icon name="Check" size={12} /></div>
          </div>
          <p class="fr-extension-chat-result" data-extension-agent-update>{selectedApp.agentUpdate}</p>
        </article>
      </div>

      <form class="fr-extension-chat-composer" onsubmit="return false">
        <button aria-label={labels.attachLabel} type="button"><Icon name="Plus" size={14} /></button>
        <label class="sr-only" for="extension-chat-input">{labels.promptPlaceholder}</label>
        <input id="extension-chat-input" placeholder={labels.promptPlaceholder} readonly type="text" />
        <button aria-label={labels.sendLabel} class="fr-extension-chat-composer__send" type="button"><Icon name="ArrowUp" size={14} /></button>
      </form>
    </div>
  </section>

  <section class="fr-extension-workspace-window" aria-label={labels.workspaceTitle}>
    <header class="fr-extension-window-bar">
      <span class="fr-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <strong>{labels.workspaceTitle}</strong>
      <span></span>
    </header>

    <div class="fr-extension-workspace-window__layout">
      <aside class="fr-extension-switcher" aria-label={labels.installedLabel}>
        <div class="fr-extension-switcher__agent">
          <Icon name="ChevronRight" size={14} />
          <Icon name="Bot" size={15} />
          <strong>{labels.agentFolderLabel}</strong>
          <span>6</span>
        </div>
        <div class="fr-extension-switcher__apps" role="group" aria-label={labels.openLabel}>
          {apps.map((app, index) => (
            <div class="fr-extension-tree-branch" data-extension-branch style={`--extension-accent: ${app.accent}`}>
              <button
                aria-pressed={index === 0 ? "true" : "false"}
                aria-controls={`extension-panel-${app.id}`}
                data-agent-update={app.agentUpdate}
                data-document-name={app.files[0]}
                data-document-path={`extensions/${app.id}/${app.files[0]}`}
                data-extension-app={app.id}
                style={`--extension-accent: ${app.accent}`}
                type="button"
              >
                <span class="fr-extension-tree-branch__chevrons" aria-hidden="true">
                  <Icon class="fr-tree-chevron--closed" name="ChevronRight" size={14} />
                  <Icon class="fr-tree-chevron--open" name="ChevronDown" size={14} />
                </span>
                <span class="fr-extension-tree-branch__folders" aria-hidden="true">
                  <Icon class="fr-tree-folder--closed" name="Folder" size={16} />
                  <Icon class="fr-tree-folder--open" name="FolderOpen" size={16} />
                </span>
                <strong>{app.name.toLowerCase()}</strong>
              </button>
              <div class="fr-extension-tree-files" hidden={index !== 0}>
                {app.files.map((file, fileIndex) => (
                  <button
                    aria-current={index === 0 && fileIndex === 0 ? "page" : undefined}
                    class="fr-extension-tree-file"
                    data-document-name={file}
                    data-document-path={`extensions/${app.id}/${file}`}
                    data-extension-file
                    type="button"
                  >
                    <Icon name="ScanText" size={14} />
                    <span>{file}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </aside>

      <div class="fr-extension-app-surface">
        <header class="fr-extension-document-bar">
          <Icon name="ScanText" size={17} />
          <div>
            <strong data-extension-document-name>{selectedFile}</strong>
            <small data-extension-document-path>extensions/{selectedApp.id}/{selectedFile}</small>
          </div>
          <span class="fr-extension-document-bar__saved"><Icon name="Check" size={14} />{labels.savedLabel}</span>
          <span class="fr-extension-document-bar__save"><Icon name="Save" size={14} />{labels.saveLabel}</span>
        </header>

        <div class="fr-extension-document-editor">
        {apps.map((app, appIndex) => (
          <article
            data-extension-panel={app.id}
            hidden={appIndex !== 0}
            id={`extension-panel-${app.id}`}
            style={`--extension-accent: ${app.accent}`}
          >
            <span class="fr-extension-document-editor__category">{app.category} · {app.name}</span>
            <h3>{app.headline}</h3>
            <p class="fr-extension-document-editor__lede">{app.description}</p>
            <p class="fr-extension-document-editor__agent"><strong>{labels.agentActivityLabel}:</strong> {app.agentUpdate}</p>

            <h4>{labels.activityLabel}</h4>
            <ol class="fr-extension-document-list">
              {app.items.map((item) => (
                <li>
                  <span><time>{item.time}</time><small>{item.state}</small></span>
                  <div><strong>{item.title}</strong><p>{item.detail}</p></div>
                </li>
              ))}
            </ol>
          </article>
        ))}
        </div>
        <footer class="fr-extension-document-footer" aria-hidden="true"><Icon name="TerminalSquare" size={13} /><Icon name="ScanText" size={13} /></footer>
      </div>
    </div>
  </section>
</div>

<script>
  document.querySelectorAll("[data-extension-demo]").forEach((root) => {
    const buttons = Array.from(root.querySelectorAll("[data-extension-app]"));
    const fileButtons = Array.from(root.querySelectorAll("[data-extension-file]"));
    const panels = Array.from(root.querySelectorAll("[data-extension-panel]"));
    const agentName = root.querySelector("[data-extension-agent-name]");
    const agentUpdate = root.querySelector("[data-extension-agent-update]");
    const documentName = root.querySelector("[data-extension-document-name]");
    const documentPath = root.querySelector("[data-extension-document-path]");
    const agentFile = root.querySelector("[data-extension-agent-file]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const appId = button.getAttribute("data-extension-app");
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        panels.forEach((panel) => {
          panel.toggleAttribute("hidden", panel.getAttribute("data-extension-panel") !== appId);
        });
        root.querySelectorAll("[data-extension-branch]").forEach((branch) => {
          const branchButton = branch.querySelector("[data-extension-app]");
          const files = branch.querySelector(".fr-extension-tree-files");
          if (files) files.toggleAttribute("hidden", branchButton !== button);
        });

        fileButtons.forEach((fileButton) => fileButton.removeAttribute("aria-current"));
        button.closest("[data-extension-branch]")?.querySelector("[data-extension-file]")?.setAttribute("aria-current", "page");

        const name = button.querySelector("strong")?.textContent;
        if (agentName && name) agentName.textContent = name;
        if (agentUpdate) agentUpdate.textContent = button.getAttribute("data-agent-update") || "";
        if (documentName) documentName.textContent = button.getAttribute("data-document-name") || "";
        if (documentPath) documentPath.textContent = button.getAttribute("data-document-path") || "";
        if (agentFile) agentFile.textContent = button.getAttribute("data-document-path") || "";
      });
    });

    fileButtons.forEach((fileButton) => {
      fileButton.addEventListener("click", () => {
        fileButtons.forEach((item) => item.removeAttribute("aria-current"));
        fileButton.setAttribute("aria-current", "page");
        if (documentName) documentName.textContent = fileButton.getAttribute("data-document-name") || "";
        if (documentPath) documentPath.textContent = fileButton.getAttribute("data-document-path") || "";
        if (agentFile) agentFile.textContent = fileButton.getAttribute("data-document-path") || "";
      });
    });
  });
</script>
