---
import kucedr from "../data/kucedr-product.json";

const suggestions = kucedr.demoSuggestions;
---

<div class="mini-app" data-mini-app aria-label="Kucedr desktop assistant demo">
  <div class="mini-app__titlebar">
    <div class="window-lights" aria-hidden="true">
      <span class="window-lights__red"></span>
      <span class="window-lights__yellow"></span>
      <span></span>
    </div>
    <div class="mini-app__title">
      <img alt="" class="brand-logo brand-logo--small" height="16" src="/icon-rounded.png" width="16" />
      Kucedr
    </div>
    <div class="mini-app__shortcut">Option Space</div>
  </div>

  <div class="mini-app__body">
    <div class="mini-app__reply" aria-live="polite">
      <span class="mini-app__prompt" aria-hidden="true">&gt;</span>
      <span data-demo-reply>Ask Kucedr anything, or pick a suggestion below.</span>
      <span class="mini-app__caret" data-demo-caret hidden></span>
    </div>

    <form class="mini-app__form" data-demo-form>
      <label class="sr-only" for="kucedr-demo-input">Ask Kucedr</label>
      <span class="mini-app__prompt" aria-hidden="true">&gt;</span>
      <input
        autocomplete="off"
        data-demo-input
        id="kucedr-demo-input"
        placeholder="Ask Kucedr..."
        spellcheck="false"
        type="text"
      />
      <button aria-label="Send prompt" data-demo-send disabled type="submit">
        Send
      </button>
    </form>

    <div class="mini-app__chips" aria-label="Demo prompts">
      {
        suggestions.map((suggestion) => (
          <button
            class="chip"
            data-answer={suggestion.answer}
            data-question={suggestion.question}
            type="button"
          >
            {suggestion.question}
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  (() => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll("[data-mini-app]").forEach((root) => {
      const form = root.querySelector("[data-demo-form]");
      const input = root.querySelector("[data-demo-input]");
      const reply = root.querySelector("[data-demo-reply]");
      const caret = root.querySelector("[data-demo-caret]");
      const send = root.querySelector("[data-demo-send]");
      const chips = Array.from(root.querySelectorAll("[data-question]"));
      let streamTimer;

      if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement) || !reply || !caret || !send) {
        return;
      }

      const setBusy = (busy) => {
        root.toggleAttribute("data-streaming", busy);
        input.disabled = busy;
        send.disabled = busy || !input.value.trim();
        chips.forEach((chip) => {
          chip.disabled = busy;
        });
        caret.hidden = !busy;
      };

      const writeReply = (text) => {
        window.clearTimeout(streamTimer);
        if (reduceMotion) {
          reply.textContent = text;
          setBusy(false);
          return;
        }

        setBusy(true);
        reply.textContent = "";
        let index = 0;

        const tick = () => {
          if (index >= text.length) {
            setBusy(false);
            return;
          }

          const step = Math.min(text.length - index, 2 + Math.floor(Math.random() * 3));
          index += step;
          reply.textContent = text.slice(0, index);
          streamTimer = window.setTimeout(tick, 18 + Math.random() * 28);
        };

        tick();
      };

      const submit = (question, answer) => {
        const prompt = question.trim();
        if (!prompt || root.hasAttribute("data-streaming")) {
          return;
        }

        input.value = "";
        send.disabled = true;
        const fallback =
          `I can help with "${prompt}". In the app I would inspect the selected context, ask before sensitive actions, and return a concise next step.`;
        writeReply(answer || fallback);
      };

      input.addEventListener("input", () => {
        send.disabled = !input.value.trim() || root.hasAttribute("data-streaming");
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const question = input.value;
        const matchingChip = chips.find((chip) => chip.dataset.question === question.trim());
        submit(question, matchingChip?.dataset.answer);
      });

      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          chips.forEach((item) => item.removeAttribute("aria-pressed"));
          chip.setAttribute("aria-pressed", "true");
          submit(chip.dataset.question || "", chip.dataset.answer || "");
        });
      });
    });
  })();
</script>
