---
import DownloadMenu from "./DownloadMenu.astro";
import DocumentationPreview from "./DocumentationPreview.astro";
import Icon from "./Icon.astro";
import ProductMockup from "./ProductMockup.astro";
import socialLinks from "../data/social-links.json";
import { getLocaleContent, localizedPath, normalizeLocale, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const { kucedr, home, site, ui } = getLocaleContent(locale);

const sp = (t: string) => {
  const i = t.indexOf("|");
  return i === -1 ? [t, ""] : [t.slice(0, i), t.slice(i + 1)];
};
const githubUrl = "https://github.com/HaraldBregu/kucedr";
const heroPillars = kucedr.heroPillars;
const mcpHighlights = kucedr.landingMcp;
const channelHighlights = kucedr.landingChannels;
const isLiveStatus = (status: string) => status === "Live" || status === "Attivo";
const activeChannel = channelHighlights.find((channel) => isLiveStatus(channel.status)) ?? channelHighlights[0];
const operatorGroups = kucedr.landingOperatorGroups;
const providerGroups = kucedr.landingProviderGroups;
const showcaseText = locale === "it"
  ? {
      tag: "App desktop",
      title: "Tutto in una sola finestra",
      description:
        "Le risposte arrivano in streaming, immagini e PDF si allegano a qualsiasi richiesta e i media generati si riproducono in linea. Ogni chiamata a strumento è raggruppata in un riepilogo che puoi aprire e leggere.",
    }
  : {
      tag: "Desktop app",
      title: "Everything in one window",
      description:
        "Answers stream in, images and PDFs attach to any request, and generated media plays inline. Every tool call is grouped into an activity summary you can open and read.",
    };
const channelSectionText = locale === "it"
  ? {
      live: "Disponibile ora",
      routeLabel: "Il percorso di ogni messaggio",
      origin: "La tua chat",
      assistant: "Kucedr",
      reply: "Stesso thread",
      controls: ["DM in allowlist, aperti o negati", "Provider e modello di risposta propri", "Risposte nello stesso thread"],
      securityTitle: "Decidi tu chi può contattare Kucedr.",
      securityDescription: "Ogni canale mantiene token, allowlist dei mittenti e modello di risposta separati sul tuo desktop. I canali disabilitati o senza token rifiutano tutto.",
    }
  : {
      live: "Available now",
      routeLabel: "Every message makes a round trip",
      origin: "Your chat",
      assistant: "Kucedr",
      reply: "Same thread",
      controls: ["Allowlist, open, or deny DMs", "Its own reply provider and model", "Same-thread replies"],
      securityTitle: "You decide who can reach Kucedr.",
      securityDescription: "Each channel keeps its own token, sender allowlist, and reply model on your desktop. Disabled or tokenless channels reject everything.",
    };
---

<section class="lp-hero" id="product">
  <div class="shell lp-hero__inner">
    <div class="lp-hero__copy">
      <p class="eyebrow">
        {kucedr.release.version}
        <span>/</span>
        {kucedr.release.phase}
      </p>
      {
        locale === "it" ? (
          <h1 class="lp-hero__title">Il tuo assistente personale AI <em>desktop</em></h1>
        ) : (
          <h1 class="lp-hero__title">Your <em>Desktop</em> AI Personal Assistant</h1>
        )
      }
      <p class="lede">{kucedr.hero.description}</p>
      <div class="cta-row cta-row--center">
        <DownloadMenu label={site.cta.label} locale={locale} />
        {
          githubUrl ? (
            <a class="button button--secondary" href={githubUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="Github" size={17} />
              {ui.github}
            </a>
          ) : null
        }
        <a class="text-link" href={localizedPath("/releases", locale)}>
          {ui.releaseNotes}
          <Icon name="ArrowRight" size={16} />
        </a>
      </div>
      <p class="cta-note">{home.downloadNote}</p>
    </div>
  </div>
</section>

<section class="lp-showcase" aria-label={locale === "it" ? "Anteprima dell'app desktop Kucedr" : "Kucedr desktop app preview"}>
  <div class="shell lp-showcase__inner">
    <div class="lp-showcase__copy">
      <span class="section-tag">{showcaseText.tag}</span>
      <h2>{showcaseText.title}</h2>
      <p>{showcaseText.description}</p>
      <div class="lp-showcase__points" aria-label={locale === "it" ? "Punti chiave del prodotto" : "Product highlights"}>
        {
          heroPillars.map((pillar) => (
            <div class="lp-showcase__point">
              <strong>{pillar.title}</strong>
              <p>{pillar.text}</p>
            </div>
          ))
        }
      </div>
    </div>
    <div class="lp-showcase__preview">
      <ProductMockup locale={locale} />
    </div>
  </div>
</section>

<section class="section reference-section" id="features">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 01 · {home.featuresEyebrow}</span>
      <h2>{sp(home.featuresTitle)[0]}{sp(home.featuresTitle)[1] && <><br/><span class="heading-muted">{sp(home.featuresTitle)[1]}</span></>}</h2>
    </header>
    <div class="features-grid">
      {
        kucedr.landingFeatures.map((feature) => (
          <article class="feature">
            <div class="feature__meta">
              <span>{feature.key}</span>
              <span class="status-pill">{feature.status}</span>
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section reference-section" id="how">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 02 · {home.howEyebrow}</span>
      <h2>{sp(home.howTitle)[0]}{sp(home.howTitle)[1] && <><br/><span class="heading-muted">{sp(home.howTitle)[1]}</span></>}</h2>
    </header>
    <div class="how-steps">
      {
        kucedr.howSteps.map((step) => (
          <article class="how-step">
            <p>{step.label}</p>
            <span>{step.glyph}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="shell quote-section__inner">
    <span aria-hidden="true">"</span>
    <p>{kucedr.quote.text}</p>
    <cite>{kucedr.quote.cite}</cite>
  </div>
</section>

<section class="section reference-section" id="mcp">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 03 · {home.mcpEyebrow}</span>
      <h2>{sp(home.mcpTitle)[0]}{sp(home.mcpTitle)[1] && <><br/><span class="heading-muted">{sp(home.mcpTitle)[1]}</span></>}</h2>
    </header>
    <div class="mcp-grid">
      {
        mcpHighlights.map((item) => (
          <article class="mcp-card">
            <div class="mcp-card__top">
              <div class="card-icon">
                <Icon name={item.icon} size={19} />
              </div>
              <span>{item.label}</span>
            </div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section reference-section" id="channels">
  <div class="shell">
    <header class="reference-head channel-head">
      <div>
        <span class="section-tag">§ 04 · {home.channelsEyebrow}</span>
        <h2>{sp(home.channelsTitle)[0]}{sp(home.channelsTitle)[1] && <><br/><span class="heading-muted">{sp(home.channelsTitle)[1]}</span></>}</h2>
      </div>
      <p>{home.channelsPanelDescription}</p>
    </header>
    <div class="channel-showcase">
      <article class="channel-feature">
        <div class="channel-feature__header">
          <div class="channel-feature__identity">
            <span class="channel-feature__icon">
              <Icon name={activeChannel.icon} size={24} />
            </span>
            <div>
              <span>{channelSectionText.live}</span>
              <h3>{activeChannel.name}</h3>
            </div>
          </div>
          <span class="channel-status channel-status--live">
            <span aria-hidden="true"></span>
            {activeChannel.status}
          </span>
        </div>

        <p class="channel-feature__description">{activeChannel.description}</p>

        <div class="channel-route" aria-label={channelSectionText.routeLabel}>
          <div class="channel-route__step">
            <Icon name="MessageSquare" size={18} />
            <span>{channelSectionText.origin}</span>
          </div>
          <Icon class="channel-route__arrow" name="ArrowRight" size={17} />
          <div class="channel-route__step channel-route__step--kucedr">
            <Icon name="Bot" size={18} />
            <span>{channelSectionText.assistant}</span>
          </div>
          <Icon class="channel-route__arrow" name="ArrowRight" size={17} />
          <div class="channel-route__step">
            <Icon name="Reply" size={18} />
            <span>{channelSectionText.reply}</span>
          </div>
        </div>

        <ul class="channel-controls" aria-label={locale === "it" ? "Controlli del canale" : "Channel controls"}>
          {channelSectionText.controls.map((control) => <li><Icon name="Check" size={14} />{control}</li>)}
        </ul>
      </article>
    </div>

    <div class="channel-assurance">
      <span class="channel-assurance__icon"><Icon name="ShieldCheck" size={21} /></span>
      <div>
        <h3>{channelSectionText.securityTitle}</h3>
        <p>{channelSectionText.securityDescription}</p>
      </div>
    </div>
  </div>
</section>

<section class="section reference-section" id="operators">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 05 · {home.operatorsEyebrow}</span>
      <h2>{sp(home.operatorsTitle)[0]}{sp(home.operatorsTitle)[1] && <><br/><span class="heading-muted">{sp(home.operatorsTitle)[1]}</span></>}</h2>
    </header>
    <div class="operator-groups">
      {
        operatorGroups.map((group) => (
          <section class="operator-group" aria-label={group.label}>
            <div class="operator-group__head">
              <div>
                <p>{group.label}</p>
                <span>{group.description}</span>
              </div>
            </div>
            <div class="operator-highlights">
              {
                group.items.map((op) => (
                  <article class="op-card">
                    <div class="op-card__top">
                      <div class="card-icon">
                        <Icon name={op.icon} size={19} />
                      </div>
                      <span class={isLiveStatus(op.status) ? "op-status op-status--live" : "op-status op-status--soon"}>
                        {op.status}
                      </span>
                    </div>
                    <h3>{op.name}</h3>
                    <p>{op.description}</p>
                  </article>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
    <a class="text-link section-link" href={localizedPath("/operators", locale)}>
      {locale === "it" ? "Vedi tutti i workflow" : "View all workflows"}
      <Icon name="ArrowRight" size={16} />
    </a>
  </div>
</section>

<section class="section reference-section" id="providers">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 06 · {home.providersEyebrow}</span>
      <h2>{sp(home.providersTitle)[0]}{sp(home.providersTitle)[1] && <><br/><span class="heading-muted">{sp(home.providersTitle)[1]}</span></>}</h2>
    </header>
    <div class="provider-groups">
      {
        providerGroups.map((group) => (
          <div class="provider-group">
            <p class="provider-group__label">{group.label}</p>
            <div class="provider-group__chips">
              {group.examples.map((ex) => <span>{ex}</span>)}
            </div>
          </div>
        ))
      }
    </div>
    <a class="text-link section-link" href={localizedPath("/providers", locale)}>
      {locale === "it" ? "Vedi tutti i provider" : "View all providers"}
      <Icon name="ArrowRight" size={16} />
    </a>
  </div>
</section>

{locale === "en" ? <DocumentationPreview /> : null}

<section class="section reference-section" id="faq">
  <div class="shell">
    <header class="reference-head reference-head--right">
      <div class="section-tag-row">
        <span class="section-tag">§ 07 · {home.faqEyebrow}</span>
      </div>
      <h2>{home.faqTitle}</h2>
    </header>
    <div class="faq-list">
      {
        kucedr.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span>{faq.question}</span>
              <Icon name="Plus" size={18} />
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="download-section" id="download">
  <div class="shell download-section__inner">
    <h2>{home.downloadTitle}</h2>
    <div class="cta-row cta-row--center">
      <DownloadMenu label={home.downloadLabel} locale={locale} />
      {
        githubUrl ? (
          <a class="button button--secondary" href={githubUrl}>
            <Icon name="Github" size={17} />
            {ui.starOnGithub}
          </a>
        ) : null
      }
    </div>
    <p>{home.releaseFootnote} / {kucedr.release.version} beta</p>
  </div>
</section>
