---
import Icon from "./Icon.astro";

const installCommand = "curl -fsSL https://kucedr.example.com/install.sh | bash";
const quickStartCards = [
  {
    icon: "MonitorDown",
    title: "Runs on Your Machine",
    description: "Use Kucedr on macOS, Linux, or Windows with local files, tools, and scoped credentials.",
  },
  {
    icon: "MessagesSquare",
    title: "Any Work Surface",
    description: "Route requests through chat, repositories, docs, and the desktop workflows you already use.",
  },
  {
    icon: "Database",
    title: "Persistent Context",
    description: "Keep useful project memory, preferences, and decisions available without repeating yourself.",
  },
];
---

<section class="section quickstart-section" data-quickstart id="quick-start">
  <div class="shell">
    <h2 class="quickstart-heading">
      <span aria-hidden="true"></span>
      Quick Start
    </h2>

    <div class="quickstart-terminal">
      <div class="quickstart-terminal__bar">
        <div aria-hidden="true" class="quickstart-lights">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div aria-label="Install method" class="quickstart-tabs">
          <span class="is-active">One-liner</span>
          <span>npm</span>
          <span>Hackable</span>
        </div>
        <div aria-label="Platform" class="quickstart-tabs quickstart-tabs--platform">
          <span class="is-active">macOS & Linux</span>
          <span>Windows</span>
        </div>
      </div>

      <div class="quickstart-command">
        <p># Installs Kucedr, checks requirements, and creates a local workspace.</p>
        <div class="quickstart-command__line">
          <span aria-hidden="true">$</span>
          <code data-command>{installCommand}</code>
          <button aria-label="Copy install command" data-copy-command type="button">
            <Icon name="Copy" size={18} />
            <span>Copy</span>
          </button>
        </div>
      </div>
    </div>

    <p class="quickstart-note">
      Works on macOS, Linux, and Windows. Start with the one-liner, then switch providers,
      models, and tool permissions from Kucedr's local settings.
    </p>

    <h2 class="quickstart-heading quickstart-heading--secondary">
      <span aria-hidden="true"></span>
      What It Does
    </h2>

    <div class="quickstart-card-grid">
      {
        quickStartCards.map((card) => (
          <article class="quickstart-card">
            <Icon name={card.icon} size={38} />
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const quickStart = document.querySelector("[data-quickstart]");
  const copyButton = quickStart?.querySelector("[data-copy-command]");
  const command = quickStart?.querySelector("[data-command]")?.textContent?.trim();

  copyButton?.addEventListener("click", async () => {
    if (!command || !navigator.clipboard) return;

    await navigator.clipboard.writeText(command);
    copyButton.setAttribute("data-copied", "true");
    copyButton.setAttribute("aria-label", "Install command copied");

    window.setTimeout(() => {
      copyButton.removeAttribute("data-copied");
      copyButton.setAttribute("aria-label", "Copy install command");
    }, 1800);
  });
</script>
