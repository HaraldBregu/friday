---
import Icon from "./Icon.astro";

interface SidebarItem {
  title: string;
  description: string;
  icon: string;
}

interface Labels {
  eyebrow: string;
  title: string;
  description: string;
  settingsTitle: string;
  settingsDescription: string;
  assistantLabel: string;
  drawTitle: string;
  canvasHint: string;
  menuLabel: string;
  libraryLabel: string;
  lockLabel: string;
  toolLabel: string;
  emptyTitle: string;
  emptyDescription: string;
  searchHint: string;
  drawHint: string;
  shortcutHint: string;
  helpLabel: string;
  sidebarItems: SidebarItem[];
}

interface Props {
  labels: Labels;
}

const { labels } = Astro.props;
const tools = [
  { icon: "Hand", label: "Pan" },
  { icon: "MousePointer2", label: "Select" },
  { icon: "Square", label: "Rectangle" },
  { icon: "Shapes", label: "Diamond" },
  { icon: "Circle", label: "Ellipse" },
  { icon: "ArrowRight", label: "Arrow" },
  { icon: "Minus", label: "Line" },
  { icon: "Pencil", label: "Draw" },
  { icon: "Type", label: "Text" },
  { icon: "Image", label: "Image" },
  { icon: "Eraser", label: "Eraser" },
];
---

<section class="fr-draw-example" aria-labelledby="draw-extension-title">
  <header class="fr-draw-example__copy">
    <p class="fr-kicker">{labels.eyebrow}</p>
    <h3 id="draw-extension-title">{labels.title}</h3>
    <p>{labels.description}</p>
  </header>

  <div class="fr-draw-demo" data-draw-demo>
    <section class="fr-draw-settings-window" aria-label={labels.settingsTitle}>
      <header class="fr-extension-window-bar">
        <span class="fr-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <strong>{labels.settingsTitle}</strong>
        <span></span>
      </header>
      <div class="fr-draw-settings-window__body">
        <div class="fr-draw-settings-window__intro">
          <strong>{labels.settingsTitle}</strong>
          <p>{labels.settingsDescription}</p>
        </div>
        <div class="fr-draw-settings-list">
          {labels.sidebarItems.slice(0, 3).map((item) => (
            <div><span><Icon name={item.icon} size={15} /></span><p><strong>{item.title}</strong><small>{item.description}</small></p></div>
          ))}
        </div>
        <small class="fr-draw-settings-window__label">{labels.assistantLabel}</small>
        <div class="fr-draw-settings-list fr-draw-settings-list--assistant">
          {labels.sidebarItems.slice(3).map((item) => (
            <div><span><Icon name={item.icon} size={15} /></span><p><strong>{item.title}</strong><small>{item.description}</small></p></div>
          ))}
        </div>
      </div>
    </section>

    <section class="fr-draw-window" aria-label={labels.drawTitle}>
      <header class="fr-extension-window-bar">
        <span class="fr-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <strong>{labels.drawTitle}</strong>
        <span></span>
      </header>

      <div class="fr-draw-canvas">
        <button aria-label={labels.menuLabel} class="fr-draw-canvas__menu" type="button"><Icon name="Menu" size={17} /></button>
        <div class="fr-draw-toolbar" role="toolbar" aria-label={labels.toolLabel}>
          <button aria-label={labels.lockLabel} type="button"><Icon name="LockKeyhole" size={15} /></button>
          <span></span>
          {tools.map((tool, index) => (
            <button aria-label={tool.label} aria-pressed={index === 1 ? "true" : "false"} data-draw-tool type="button">
              <Icon name={tool.icon} size={16} />
              <small>{index + 1}</small>
            </button>
          ))}
        </div>
        <button class="fr-draw-canvas__library" type="button"><Icon name="BookOpen" size={15} />{labels.libraryLabel}</button>

        <p class="fr-draw-canvas__hint">{labels.canvasHint}</p>
        <p class="fr-draw-annotation fr-draw-annotation--menu">{labels.searchHint}</p>
        <p class="fr-draw-annotation fr-draw-annotation--tool">{labels.drawHint}</p>
        <p class="fr-draw-annotation fr-draw-annotation--help">{labels.shortcutHint}</p>

        <div class="fr-draw-canvas__empty">
          <Icon name="Pencil" size={30} />
          <h4>{labels.emptyTitle}</h4>
          <p>{labels.emptyDescription}</p>
          <span><Icon name="HelpCircle" size={14} />{labels.helpLabel}<kbd>?</kbd></span>
        </div>

        <div class="fr-draw-zoom" aria-label="Canvas zoom">
          <button aria-label="Zoom out" type="button"><Icon name="Minus" size={14} /></button><strong>100%</strong><button aria-label="Zoom in" type="button"><Icon name="Plus" size={14} /></button>
        </div>
        <div class="fr-draw-history" aria-label="Canvas history">
          <button aria-label="Undo" type="button"><Icon name="Undo2" size={14} /></button><button aria-label="Redo" type="button"><Icon name="Redo2" size={14} /></button>
        </div>
        <button aria-label={labels.helpLabel} class="fr-draw-canvas__help" type="button"><Icon name="HelpCircle" size={16} /></button>
      </div>
    </section>
  </div>
</section>

<script>
  document.querySelectorAll("[data-draw-demo]").forEach((root) => {
    const buttons = Array.from(root.querySelectorAll("[data-draw-tool]"));
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      });
    });
  });
</script>
