---
import Icon from "./Icon.astro";

interface Props {
  integration: {
    name: string;
    category: string;
    description: string;
    icon: string;
  };
  index?: number;
}

const { integration, index = 0 } = Astro.props;
---

<article class="integration-card">
  <div class="integration-card__top">
    <span class="integration-card__number">{String(index + 1).padStart(2, "0")}</span>
    <div class="card-icon">
      <Icon name={integration.icon} size={17} />
    </div>
  </div>
  <p class="integration-card__category">{integration.category}</p>
  <h3>{integration.name}</h3>
  <p>{integration.description}</p>
</article>
