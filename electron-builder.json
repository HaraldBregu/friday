{
	"productName": "Friday",
	"appId": "com.friday.friday",
	"copyright": "© 2026 Friday Project. All rights reserved.",
	"files": [
		"out/**",
		"resources/**",
		"!resources/skills/**",
		"!resources/sounds/**",
		"!resources/svgs/**",
		"!resources/providers/**/*.svg"
	],
	"icon": "./resources/icons/win/icon.ico",
	"fileAssociations": [
		{
			"ext": "tsrct",
			"name": "Friday Document",
			"description": "Friday Document File",
			"mimeType": "application/x-friday-document",
			"role": "Manager",
			"icon": "./resources/icons/icon.png"
		}
	],
	"protocols": [
		{
			"name": "Friday Authentication",
			"schemes": ["friday"]
		}
	],
	"publish": null,
	"asar": true,
	"asarUnpack": [
		"node_modules/@anthropic-ai/sandbox-runtime/vendor/**/*",
		"node_modules/@silvia-odwyer/photon-node/**/*",
		"node_modules/node-pty/**/*"
	],
	"nodeGypRebuild": false,
	"buildDependenciesFromSource": false,
	"npmRebuild": true,
	"mac": {
		"target": [
			{
				"target": "pkg",
				"arch": ["x64", "arm64"]
			},
			{
				"target": "dmg",
				"arch": ["x64", "arm64"]
			}
		],
		"icon": "./resources/icons/mac/icon.icns",
		"extendInfo": {
			"LSApplicationCategoryType": "public.app-category.utilities",
			"NSMicrophoneUsageDescription": "Friday needs access to your microphone for audio recording features.",
			"NSCameraUsageDescription": "Friday needs access to your camera for video recording features.",
			"NSBluetoothAlwaysUsageDescription": "Friday needs access to Bluetooth to connect and manage Bluetooth devices.",
			"NSBluetoothPeripheralUsageDescription": "Friday needs access to Bluetooth peripherals for device connectivity.",
			"CFBundleDocumentTypes": [
				{
					"CFBundleTypeName": "Friday File",
					"CFBundleTypeIconFile": "fileIcon.icns",
					"CFBundleTypeExtensions": ["tsrct"],
					"CFBundleTypeRole": "Manager",
					"LSHandlerRank": "Owner",
					"LSItemContentTypes": ["com.friday.friday.document"]
				}
			],
			"UTExportedTypeDeclarations": [
				{
					"UTTypeIdentifier": "com.friday.friday.document",
					"UTTypeDescription": "Friday File",
					"UTTypeConformsTo": ["public.data"],
					"UTTypeTagSpecification": {
						"public.filename-extension": ["tsrct"],
						"public.mime-type": ["application/x-friday-document"]
					}
				}
			]
		},
		"artifactName": "${productName}-${version}-${arch}.${ext}",
		"darkModeSupport": true,
		"hardenedRuntime": true,
		"gatekeeperAssess": false,
		"entitlements": "./resources/entitlements.mac.plist",
		"entitlementsInherit": "./resources/entitlements.mac.plist",
		"notarize": true,
		"type": "distribution",
		"extraResources": [
			{
				"from": "./resources",
				"to": "resources",
				"filter": ["**/*", "!skills/**", "!sounds/**", "!svgs/**", "!providers/**/*.svg"]
			}
		]
	},
	"pkg": {
		"allowAnywhere": true,
		"allowCurrentUserHome": true,
		"allowRootDirectory": true,
		"isRelocatable": false,
		"isVersionChecked": true,
		"hasStrictIdentifier": true,
		"overwriteAction": "upgrade",
		"artifactName": "${productName}-installer-${version}-${arch}.${ext}"
	},
	"linux": {
		"target": [
			{ "target": "deb", "arch": ["x64"] },
			{ "target": "AppImage", "arch": ["x64"] },
			{ "target": "tar.gz", "arch": ["x64"] }
		],
		"category": "Utility",
		"artifactName": "${productName}-${version}.${ext}",
		"icon": "./resources/icons/png",
		"maintainer": "Friday Project",
		"synopsis": "Your desktop AI copilot for everyday tasks",
		"description": "Friday is a cross-platform desktop AI assistant that turns conversations into actions. Type or speak a request, attach images or PDFs, and let the agent work with files, run commands, research the web, create media, or automate recurring tasks.",
		"vendor": "Friday Project",
		"executableName": "friday-desktop",
		"desktop": {
			"entry": {
				"Type": "Application",
				"Name": "Friday",
				"Comment": "Your desktop AI copilot for everyday tasks",
				"Icon": "friday",
				"Terminal": false,
				"Categories": "Office;WordProcessor;AI;",
				"MimeType": "application/x-friday-document;",
				"StartupNotify": true,
				"StartupWMClass": "Friday"
			}
		},
		"extraResources": [
			{
				"from": "./resources",
				"to": "resources",
				"filter": ["**/*", "!skills/**", "!sounds/**", "!svgs/**", "!providers/**/*.svg"]
			}
		]
	},
	"deb": {
		"packageCategory": "utils",
		"maintainer": "Friday Project <contact@friday.org>",
		"depends": [
			"libgtk-3-0",
			"libnss3",
			"libxss1",
			"libasound2",
			"libatk-bridge2.0-0",
			"libgdk-pixbuf2.0-0",
			"libx11-xcb1",
			"libxcomposite1",
			"libxdamage1",
			"libxrandr2",
			"libxcursor1",
			"libxext6",
			"libxcb1",
			"libnspr4",
			"libdrm2",
			"libcups2",
			"libexpat1",
			"libpulse0",
			"libv4l-0",
			"bubblewrap",
			"socat",
			"ripgrep"
		]
	},
	"win": {
		"icon": "./resources/icons/win/icon.ico",
		"target": [
			{ "target": "nsis", "arch": ["x64"] },
			{ "target": "portable", "arch": ["x64"] }
		],
		"signAndEditExecutable": true,
		"artifactName": "${productName}.${ext}",
		"forceCodeSigning": true,
		"signtoolOptions": {
			"publisherName": "Friday Project"
		},
		"requestedExecutionLevel": "asInvoker",
		"extraResources": [
			{
				"from": "./resources",
				"to": "resources",
				"filter": ["**/*", "!skills/**", "!sounds/**", "!svgs/**", "!providers/**/*.svg"]
			}
		]
	},
	"nsis": {
		"oneClick": false,
		"allowToChangeInstallationDirectory": true,
		"createDesktopShortcut": true,
		"shortcutName": "Friday",
		"multiLanguageInstaller": true,
		"warningsAsErrors": false,
		"deleteAppDataOnUninstall": false,
		"installerIcon": "./resources/icons/win/icon.ico",
		"uninstallerIcon": "./resources/icons/win/icon.ico",
		"perMachine": false,
		"artifactName": "${productName}-${version}.${ext}",
		"displayLanguageSelector": true,
		"runAfterFinish": false,
		"language": "1040",
		"installerLanguages": ["it-IT", "en-US", "es-ES", "fr-FR", "de-DE"]
	},
	"portable": {
		"artifactName": "${productName}-Portable-${version}-${arch}.${ext}",
		"requestExecutionLevel": "user"
	}
}
