name: Publish npm package

on:
  push:
    tags:
      - 'sdk-v*.*.*'
      - 'cli-v*.*.*'
  workflow_dispatch:
    inputs:
      package:
        description: Package to publish
        required: true
        type: choice
        options:
          - sdk
          - cli
      version:
        description: Exact package version
        required: true
        type: string

concurrency:
  group: npm-publish-${{ github.ref }}-${{ inputs.package }}-${{ inputs.version }}
  cancel-in-progress: false

permissions:
  contents: read
  id-token: write

jobs:
  publish:
    runs-on: ubuntu-latest
    environment: npm
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          node-version: 24
          package-manager-cache: false
      - name: Use the trusted-publishing npm version
        run: npm install --global npm@11.13.0
      - run: npm ci
      - id: package
        name: Resolve and validate the release
        shell: bash
        env:
          EVENT_NAME: ${{ github.event_name }}
          REF_NAME: ${{ github.ref_name }}
          INPUT_PACKAGE: ${{ inputs.package }}
          INPUT_VERSION: ${{ inputs.version }}
        run: |
          if [[ "$EVENT_NAME" == "workflow_dispatch" ]]; then
            package="$INPUT_PACKAGE"
            version="$INPUT_VERSION"
          elif [[ "$REF_NAME" == sdk-v* ]]; then
            package="sdk"
            version="${REF_NAME#sdk-v}"
          elif [[ "$REF_NAME" == cli-v* ]]; then
            package="cli"
            version="${REF_NAME#cli-v}"
          else
            echo "::error::Unsupported release ref: $REF_NAME"
            exit 1
          fi

          if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
            echo "::error::Invalid semantic version: $version"
            exit 1
          fi

          workspace="@kucedr/$package"
          manifest_version="$(node -p "require('./packages/$package/package.json').version")"
          if [[ "$version" != "$manifest_version" ]]; then
            echo "::error::Requested $workspace@$version but its package.json contains $manifest_version."
            exit 1
          fi

          if npm view "$workspace@$version" version >/dev/null 2>&1; then
            echo "::error::$workspace@$version already exists on npm."
            exit 1
          fi

          echo "workspace=$workspace" >> "$GITHUB_OUTPUT"
          echo "version=$version" >> "$GITHUB_OUTPUT"
      - run: npm run typecheck --workspace "${{ steps.package.outputs.workspace }}"
      - run: npm test --workspace "${{ steps.package.outputs.workspace }}"
      - run: npm pack --dry-run --workspace "${{ steps.package.outputs.workspace }}"
      - run: npm publish --workspace "${{ steps.package.outputs.workspace }}"
